
@{
    ViewData["Title"] = "Nueva Factura de Servicio";
    Layout = "";
}
<p></p>
<div class="form-group">
    <label for="fecha_concepto">Fecha del documento</label>
    <input type="date" id="fecha_concepto" name="fecha" class="form-control" />
</div>
<div class="form-group">
    <label for="no_comprobante_concepto">Código</label>
    <input type="text" id="no_comprobante_concepto" name="no_comprobante" class="form-control" />
</div>
<div class="form-group">
    <label for="Id_Factura_Servicio"> Tipo</label>
    <div id="concepto"></div>
</div>
<div class="form-group tipo_oculto">
    <label for="Id_Factura_Servicio_Basico"> Servicio Básico</label>
    <div id="concepto_servicio_basico"></div>
</div>
<div class="form-group">
    <label for="no_comprobante_concepto">Concepto</label>
    <input type="text" id="detalle_factura_servicio" name="no_comprobante" class="form-control" />
</div>
<div class="form-group telefono_visto">
    <label for="Monto_Concepto">Monto</label>
    <input type="number" id="Monto_Concepto" name="Monto" class="form-control" />
</div>
<div class="form-group telefono_oculto">
    <div class="row" >
        <div class="col-md-6">
            <label for="Monto_Concepto">Monto teléfono</label>
            <input type="number" id="Monto_telefono" name="Monto" class="form-control" />
        </div>
        <div class="col-md-6">
            <label for="Monto_Concepto">Monto internet</label>
            <input type="number" id="Monto_internet" name="Monto" class="form-control"/>
        </div>
    </div>
</div>

<div class="form-group">
    <input type="checkbox" id="es_credito_fiscal_concepto" name="es_credito_fiscal" />
    <label for="es_credito_fiscal_concepto" class="control-label">Es Crédito Fiscal</label>
</div>
<div class="form-group">
    <button class="btn btn-default" id="Guardar_Factura" aria-hidden="true">
        <span class="glyphicon glyphicon-floppy-disk"></span> Guardar
    </button>
</div>
