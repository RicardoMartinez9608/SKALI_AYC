@{
    ViewData["Title"] = "Revertir Traslado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">Reversión de Traslado de Créditos</div>
    <div class="panel-body panel-body-personalizado">
        <div class="row">
            <div class="col-lg-4">
                <input id="id_persona_valor" type="hidden" />
                <input type="text" name="dui_buscar" id="dui_buscar" placeholder="introduzca codigo completo de crédito" class="form-control" />
            </div>
            <div class="col-lg-4">
                <div class="input-group">
                    <input type="date" name="fecha" id="fecha" placeholder="Fecha " class="form-control" />
                    <span class="input-group-btn">
                        <button class="btn btn-default" type="button" id="buscarcodigo">Buscar</button>
                    </span>

                </div>
            </div>

        </div>
    </div>
  
    <div class="panel-body">
            <div class="panel panel-default">
                <div class="panel-heading">Datos del cliente</div>
                <div class="panel-body">
                    <div id="listapagos"></div>
                </div>
            </div>
        </div>

</div>
<script>
    $(document).ready(function () {
        Datos_Traslado();

    });
      function Datos_Traslado() {
          $("#buscarcodigo").click(function () {
            var fecha = $("#fecha").val();
              var codigo_credito = $("#dui_buscar").val();

             $.get("@Url.Action("Datos_Reversion_Traslado", "Caja_Boveda")",
                 {
                     codigo_credito: codigo_credito,
                     fecha_reporte:fecha
                 },
            function (lista) {
                $("#listapagos").html(lista);
                Procesar_Traslado();
            });
        });
    }
     function Procesar_Traslado() {
         $("input.revertir_traslado").click(function () {
             var id_transaccion_ahorro = $("input.id_transaccion_ahorro").val();
             var id_transaccion_credito = $("input.id_transaccion_credito").val();
             alertify.confirm('Confirmación',
                        '¿Quieres Eliminar el traslado?',
                        function() {
                              $.post("@Url.Action("Revertir_Traslado", "Caja_Boveda")",
                              {
                                  id_transaccion_credito: id_transaccion_credito,
                                  id_transaccion_ahorro: id_transaccion_ahorro
                              },
                        function (resultado) {
                            alertify.success(resultado);
                        }).fail(function (badrequest) {
                            alertify.error(badrequest.responseText);
                        });
                        },
                        function() {
                            alertify.error('Operación Cancelada');
                        });

        });
    }

</script>