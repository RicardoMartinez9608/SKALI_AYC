@model ModelNucleo.Model.Tablero.Meta

<div class="row">
    <div class="col-md-4" id="editar_form_meta">
            <input asp-for="Id_Cartera" type="hidden" class="form-control" />
            <input asp-for="Id_Meta" type="hidden" class="form-control" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="Colecta" class="control-label"></label>
                <input asp-for="Colecta" class="form-control" />
                <span asp-validation-for="Colecta" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Capital" class="control-label">Cartera</label>
                <input asp-for="Capital" class="form-control" />
                <span asp-validation-for="Capital" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cosecha" class="control-label"></label>
                <input asp-for="Cosecha" class="form-control" />
                <span asp-validation-for="Cosecha" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="No_Clientes" class="control-label"></label>
                <input asp-for="No_Clientes" class="form-control" />
                <span asp-validation-for="No_Clientes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Colocacion" class="control-label"></label>
                <input asp-for="Colocacion" class="form-control" />
                <span asp-validation-for="Colocacion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ingresos" class="control-label"></label>
                <input asp-for="Ingresos" class="form-control" />
                <span asp-validation-for="Ingresos" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Mora" class="control-label"></label>
                <input asp-for="Mora" class="form-control" />
                <span asp-validation-for="Mora" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Mes" class="control-label">Mes</label>
                <input asp-for="Mes" class="form-control" />
                <span asp-validation-for="Mes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Anyo" class="control-label">Año</label>
                <input asp-for="Anyo" class="form-control" />
                <span asp-validation-for="Anyo" class="text-danger"></span>
            </div>
            
            
            <div class="form-group">
                <input type="submit" value="Guardar" id="guardar_editar_meta" class="btn btn-default" />
            </div>
    </div>
</div>
