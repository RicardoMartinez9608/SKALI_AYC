@model ModelNucleo.Model.ModelView.Ranking_Cosecha

@if (Model.ranking.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    Id Ranking
                </th>
                <th>
                    Id Cartera
                </th>
                <th>
                    Saldo Cartera
                </th>
                <th>
                    Agencia
                </th>
                <th>
                    Asesor
                </th>
                <th>
                    Valor Pagado
                </th>
                <th>
                    Refinanciado
                </th>
                <th>
                    Abono Capital
                </th>
                <th>
                    Capital Mora
                </th>
                <th>
                    Ingresos
                </th>
                <th>
                    Desembolso
                </th>
                <th>
                    No Clientes Activos
                </th>
                <th>
                    No Creditos Activos
                </th>
                <th>
                    Fecha
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ranking)
            {
                <tr>
                    <td>
                        @item.Id_Rancking

                    </td>
                    <td>
                        @item.Id_Cartera
                    </td>
                    <td>
                        @item.Saldo_Cartera
                    </td>
                    <td>
                        @item.Agencia
                    </td>
                    <td>
                        @item.Asesor
                    </td>
                    <td>
                        @item.Valor_Pagado
                    </td>
                    <td>
                        @item.Refinanciado
                    </td>
                    <td>
                        @item.Abono_Capital
                    </td>
                    <td>
                        @item.Capital_Mora
                    </td>
                    <td>
                        @item.Ingresos
                    </td>
                    <td>
                        @item.Desembolso
                    </td>
                    <td>
                        @item.No_Clientes_Activos
                    </td>
                    <td>
                        @item.No_Creditos_Activos
                    </td>
                    <td>
                        @item.Fecha
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.cosecha.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    Agencia
                </th>
                <th>
                    Asesor
                </th>
                <th>
                    Saldo
                </th>
                <th>
                    Fecha
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.cosecha)
            {
                <tr>
                    <td>
                        @item.Agencia

                    </td>
                    <td>
                        @item.Asesor
                    </td>
                    <td>
                        @item.Saldo
                    </td>
                    <td>
                        @item.Fecha
                    </td>

                </tr>
            }
        </tbody>
    </table>
}

@if (Model.mora.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    Agencia
                </th>
                <th>
                    Asesor
                </th>
                <th>
                    Codigo
                </th>
                <th>
                    Persona
                </th>
                <th>
                    Saldo Mora
                </th>
                <th>
                    Vencimiento
                </th>
                <th>
                    Ultimo Movimiento
                </th>
                <th>
                    Dias Mora
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.mora)
            {
            <tr>
                <td>
                    @item.Agencia

                </td>
                <td>
                    @item.Asesor
                </td>
                <td>
                    @item.Codigo
                </td>
                <td>
                    @item.Nombre_Cliente
                </td>
                <td>
                    @item.Saldo_Mora
                </td>
                <td>
                    @item.Fecha_Vencimiento
                </td>
                <td>
                    @item.Fecha_Ultimo_Movimiento
                </td>
                <td>
                    @item.Dias_Mora
                </td>
            </tr>
            }
        </tbody>
    </table>
}
