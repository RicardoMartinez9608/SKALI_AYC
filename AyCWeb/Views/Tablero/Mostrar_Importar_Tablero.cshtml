
@{
    ViewData["Title"] = "Importar Tablero";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">
        <h4>Importar Tableros</h4>
    </div>
    <div class="panel-body panel-body-personalizado">
        <form>
            <div class="checkbox">
                <label>
                    <input type="checkbox" id="procesar" /> Procesar
                </label>
            </div>
            <div class="form-group">
                <select name="tipo_tablero" id="tipo_tablero">
                    <option value="0">Seleccionar un tipo del tablero</option>
                    <option value="1">Rancking</option>
                    <option value="2">Cosecha</option>
                    <option value="3">Mora</option>
                </select>
            </div>
            <p></p>
            <div class="form-group">
                <input type="file" id="fileupload" name="files" class="form-control" />
            </div>
            <p></p>
            <div class="form-group">
                <input type="button" name="Upload" value="cargar" id="btnupload" class="btn btn-primary" />
            </div>
            <hr />
            <div id="progressbar"></div>
            <hr />
            <div class="row">
                <div id="tablero"></div>

            </div>
        </form>
    </div>
</div>
<link href="~/lib/jquery-ui/jquery-ui.css" rel="stylesheet" />
<script src="~/lib/jquery-ui/jquery-ui.js"></script>
<script>

    var time = null;

    $(function () {

        IniciarProceso();

        $('#btnupload').on('click', function () {
            var fileExtension = ['xls', 'xlsx'];
            var filename = $('#fileupload').val();
            var tipo_documento = $('#tipo_tablero').val();
            if (filename.length == 0) {
                alertify.warning("Seleccionar un archivo.");
                return false;
            }
            else {
                var extension = filename.replace(/^.*\./, '');
                if ($.inArray(extension, fileExtension) == -1) {
                    alertify.warning("Por favor Seleccione Archivos de Excel");
                    return false;
                }
            }

            var fdata = new FormData();
            var fileUpload = $("#fileupload").get(0);
            var files = fileUpload.files;
            fdata.append(files[0].name, files[0]);

            var procesar = Boolean($("#procesar").prop("checked"));

            if (procesar) {
                alertify.confirm('Confirmación',
                    'Seguro que desea Porcesar los montos enlistados',
                    function () {

                        EnviarDocumento(fdata, procesar, tipo_documento);

                    },
                    function () {
                        alertify.warning('Operación Cancelada');
                    });
            } else {
                EnviarDocumento(fdata, procesar, tipo_documento);
            }
        });
    });

    function EnviarDocumento(fdata, procesar,tipo_documento) {
        try {

            var i = 0;
            var timeout = 750;

            (function progressbar() {
                i++;
                if (i < 1000) {

                    $("#progressbar").progressbar({
                        value: i
                    });

                    time=setTimeout(progressbar, timeout);
                }
            }
            )();
        }
        catch (err) {
            alert(err.message);
        }
        $.ajax({
            type: "POST",
            url: "@Url.Action("Cargar_Tablero", "Tablero")?procesar=" + procesar +"&tipo_tablero="+tipo_documento,
            data: fdata,
            contentType: false,
           processData: false,
            success: function (response) {
                if (response.length == 0)
                    alertify.error("no se pudo subir el archivo");
                else {
                    $('#tablero').html(response);
                }
                clearTimeout(time);
                $("#progressbar").progressbar({
                    value: 100
                });
            },
            error: function (e) {
                alertify.error(e.responseText);
            }

        });
    }

    function IniciarProceso() {
        $("#procesar").click(function () {
            if ($("#procesar").prop("checked"))
                alertify.warning("Si da click a Cargar se procesarán los datos en lista");
            else
                alertify.warning("Si da click a Cargar no se procesarán los datos, solo se actualizará");
        });
    }


</script>