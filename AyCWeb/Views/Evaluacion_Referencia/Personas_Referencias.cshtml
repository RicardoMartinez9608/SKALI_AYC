@model IEnumerable<ModelNucleo.Model.Persona>
@using ModelNucleo.Model.ModelView
@{
    ViewData["Title"] = "Personas referencias a consultada";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">
        Personas referencias a consultar
    </div>
    <div class="panel-body panel-body-personalizado">
        <form action="@Url.Action("Personas_Referencias","Evaluacion_Referencia")" method="get">
            <div class="row">
                <div class="col-md-6">
                    <div class="input-group">

                        <input type="text" name="buscar" class="form-control" placeholder="Buscar por...">
                        <span class="input-group-btn">
                            <input type="submit" class="btn btn-default" value="Buscar" />
                        </span>

                    </div>
                </div>
            </div>
        </form>
    </div>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.NombreCompleto)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Nit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Dui)
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.NombreCompleto)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Nit)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Dui)
                        </td>
                    </tr>

                    <tr>
                        <td colspan="3">

                            <table class="table table-bordered">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Teléfono</th>
                                    <th>Parentesco</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>

                                @foreach (var referencia in item.Persona_Referencias)
                                {
                                    @if (referencia.Tipo_Referencia == "1" || referencia.Tipo_Referencia == "2")
                                    {
                                        string disabled =referencia.Referencia.Valoracion_Referencia!=ModelNucleo.Model.Valoracion_Referencia.Indefinido  ? "disabled":"";
                                        string estado = "";
                                        string colorClass = "";
                                        if (referencia.Referencia.Valoracion_Referencia==ModelNucleo.Model.Valoracion_Referencia.No_Contesta)
                                        {
                                            estado = "<span class='glyphicon glyphicon-warning-sign'></span> No Contesta";
                                            colorClass = "empty";
                                        }
                                        if (referencia.Referencia.Valoracion_Referencia==ModelNucleo.Model.Valoracion_Referencia.Numero_Equivocado)
                                        {
                                            estado = "<span class='glyphicon glyphicon-ban-circle'></span> Número equivocado";
                                            colorClass = "bad";
                                        }

                                        if (referencia.Referencia.Valoracion_Referencia == ModelNucleo.Model.Valoracion_Referencia.Mala_Referencia)
                                        {
                                            estado = "<span class='glyphicon glyphicon-ban-circle'></span> Mala referencia";
                                            colorClass = "bad";
                                        }

                                        if (referencia.Referencia.Valoracion_Referencia==ModelNucleo.Model.Valoracion_Referencia.Buena_Referencia)
                                        {
                                            estado = "<span class='glyphicon glyphicon-ok'></span> Buena referencia";
                                            colorClass = "good";
                                        }
                                <tr class="@colorClass color_fila">
                                    <td>@referencia.Referencia.Nombre</td>
                                    <td>@referencia.Referencia.Telefono</td>
                                    <td>
                                        @Enum.GetValues(typeof(Tipo_Refencia_Option)).GetValue(Convert.ToInt32(referencia.Tipo_Referencia))
                                    </td>
                                    <td class="estado">@Html.Raw(referencia.Referencia.Valoracion_Referencia)</td>
                                    <td>

                                        <div class="btn-group" role="group" aria-label="...">
                                            <input type="hidden" value="@referencia.Id_Referencia" class="id_referencia" />
                                            <input type="hidden" value="@item.NombreCompleto" class="nombre_socio" />
                                            <input type="hidden" value="@referencia.Referencia.Nombre" class="nombre_referencia" />
                                            <input type="hidden" value="@referencia.Referencia.Telefono" class="telefono_referencia" />
                                            <input type="hidden" value="@Enum.GetValues(typeof(Tipo_Refencia_Option)).GetValue(Convert.ToInt32(referencia.Tipo_Referencia))})" class="tipo_referencia" />
                                            <a href="#modal_detalle" data-backdrop="false" data-toggle="modal" class="btn btn-default agendar">Agendar</a>
                                            <a href="#" class="btn btn-danger no_equivocado"> Número equivocado</a>
                                            <a class="btn btn-default cargar_bateria consulta @disabled" href="#modal_pregunta" data-backdrop="false" data-toggle="modal">Iniciar consulta</a>
                                        </div>
                                    </td>
                                </tr>
                                    }
                                }

                            </table>

                        </td>
                    </tr>

                }
            </tbody>
        </table>
</div>



<div class="modal fade" id="modal_detalle">
    <div class="modal-dialog" style="width:40%">
        <div class="modal-content">

            <div class="modal-header">
                <div class="btn-group pull-right" role="group" aria-label="...">

                    @*<button class="btn btn-default" id="Guardar_Perfil_Principal" aria-hidden="true">
                        <span class="glyphicon glyphicon-floppy-disk"></span> Guardar
                    </button>*@

                    <button class="btn btn-danger " data-dismiss="modal">
                        <span class="glyphicon glyphicon-remove"></span> Cerrar
                    </button>
                </div>

                <h4 class="modal-title">Manejo de llamada</h4>
            </div>

            <div class="modal-body detalle_llamada" style="overflow-y:auto; height:435px">

            </div> <!-- /.modal-body -->

        </div>
    </div>
</div>

<div class="modal fade" id="modal_pregunta">
    <div class="modal-dialog" style="width:60%;">
        <div class="modal-content">

            <div class="modal-header">
                <div class="btn-group pull-right" role="group" aria-label="...">

                    @*<button class="btn btn-default" id="Guardar_Perfil_Principal" aria-hidden="true">
                        <span class="glyphicon glyphicon-floppy-disk"></span> Guardar
                    </button>*@

                    <button class="btn btn-danger " data-dismiss="modal">
                        <span class="glyphicon glyphicon-remove"></span> Cerrar
                    </button>
                </div>

                <h4 class="modal-title">Bateria de pregunta</h4>
            </div>

            <div class="modal-body detalle_pregunta" style="height:650px;">

            </div> <!-- /.modal-body -->

        </div>
    </div>
</div>

<style>
    tr.bad {
        background-color:#faafaf;
    }
    tr.empty {
        background-color: #f8d3a4;
    }
    tr.good {
        background-color: #cdf8c5;
    }
</style>

<script>
    $("a.no_equivocado").each(function (index) {
        //$("a.no_contesta").eq(index).click(function () {
        //    Notificacion(index,false);
        //});
        $("a.no_equivocado").eq(index).click(function () {
            Notificacion(index,true);
        });
    });

    function Mostrar_Alerta(index, equivocado) {
        if (equivocado) {
            $("tr.color_fila").eq(index).addClass("bad");
            $("td.estado").eq(index).html("<span class='glyphicon glyphicon-ban-circle'></span> Número equivocado");
        }
        else {
            $("tr").eq(index).addClass("empty");
            $("td.estado").eq(index).html("<span class='glyphicon glyphicon-warning-sign'></span> No Contesta");
        }
    }

    function Notificacion(index,equivocado) {
        var no_equivocado = false;
        var no_contesta = false;

        if (equivocado) {
            no_equivocado = true;
            Mostrar_Alerta(index, equivocado);
        }
        else {
            no_contesta = true;
            Mostrar_Alerta(index, equivocado);
        }
        var id_referencia = $("input.id_referencia").eq(index).val();
            $.get("@Url.Action("Notificacion_Falla", "Evaluacion_Referencia")"
                , {
                    id_referencia: id_referencia,
                    no_equivocado: no_equivocado,
                    no_contesta: no_contesta
                }
                , function (retorno) {
                    $("a.consulta").eq(index).addClass("disabled");
                    alertify.success("La notificación ha sido reportada");
                }).fail(function (erro) {
                    alertify.success("La notificación no pudo ser reportada");
                });
    }

    function Cargar_Agendar_Llamada() {
        $("a.agendar").each(function (index) {
            $("a.agendar").eq(index).click(function () {
                var id_referencia = $("input.id_referencia").eq(index).val();
                $.get("@Url.Action("Log_Llamada", "Evaluacion_Referencia")",
                    {
                        id_referencia: id_referencia
                    },
                    function (form) {
                        $("div.detalle_llamada").html(form);
                        $("#Registrado_Para").addClass("form-control");

                        Agenda_Por_Referencia_Lista(id_referencia);
                        Guardar_Llamada();
                });
            });
        });
    }

    function Guardar_Llamada() {
        $("#Guardar_Llamada").click(function () {
            var Llamada = $("#agendar_llamada").serializeAnything();
            $.post("@Url.Action("Log_Llamada", "Evaluacion_Referencia")", Llamada, function (resultado) {
                alertify.success("Se guardo correctamente");
                var id_referencia = $("#agendar_llamada #Id_Referencia").val();
                Agenda_Por_Referencia_Lista(id_referencia);
            }).fail(function (error) {
                alertify.error("No se pudo guardar la llamada");
            });
        });
    }

    function Agenda_Por_Referencia_Lista(id_referencia) {
        $.get("@Url.Action("Logger_Llamada", "Evaluacion_Referencia")",
            {
                id_referencia: id_referencia
            },
            function (lista) {
                $("#agenda_para_referencia").html(lista);
                Llamando();
        });
    }

    function Llamando() {
        $("a.llamando").each(function (index) {
            $("a.llamando").eq(index).click(function () {
                var id_llamada = $("input.id_llamada").eq(index).val();
                $.get("@Url.Action("Rastrear_Llamada", "Evaluacion_Referencia")",
                    {
                        id_llamada: id_llamada
                    }, function () {
                        alertify.success("Se ha registrado la llamada");
                    }).fail(function () {
                        alertify.error("No se pudo Rastrear la llamada");
                    });
            });
        });
    }

    $(function () {
        Cargar_Agendar_Llamada();
        Cargar_Bateria();
    });

    function Responder_Bateria() {
        $("input.enviar_respuesta").each(function (index) {
            $("input.enviar_respuesta").eq(index).click(function () {
            
                var id_referencia = $("input.id_referencia_bateria").val();
                var id_pregunta = $("input.id_pregunta").eq(index).val();
                var id_respuesta = $("input.enviar_respuesta").eq(index).val();

                console.log("Quiero saber si se enviaron los siguientes datos: Respuesta:" + id_respuesta + " Id_Pregunta: " + id_pregunta + " Referencia: " + id_referencia);

                $.get("@Url.Action("Crear_Respuesta", "Evaluacion_Referencia")",{
                    id_referencia: id_referencia,
                    id_pregunta: id_pregunta,
                    id_respuesta: id_respuesta
                }, function (respuesta) {
                    alertify.success(respuesta);
                    Mostrar_Estado_Envio(id_pregunta, index,true);
                    }).fail(function (error) {
                        alertify.error("Existe un problema con la recolección de preguntas");
                        Mostrar_Estado_Envio(id_pregunta, index,false);
                    });
            });
        });
    }

    function Mostrar_Estado_Envio(id_pregunta, index, correcto) {
        var panel_tipo = "panel-default";
        if (correcto)
            panel_tipo = "panel-success";
        else
            panel_tipo = "panel-warning";

        $("input.enviar_respuesta").eq(index).parents("div.procesamiento_" + id_pregunta).removeClass("panel-default");
        $("input.enviar_respuesta").eq(index).parents("div.procesamiento_" + id_pregunta).addClass(panel_tipo);
    }

    function Cargar_Bateria() {
        $("a.cargar_bateria").each(function (index) {
            $("a.cargar_bateria").eq(index).click(function () {
                var id_referencia = $("input.id_referencia").eq(index).val();
                var nombre_socio = $("input.nombre_socio").eq(index).val();
                var telefono_referencia = $("input.telefono_referencia").eq(index).val();
                var tipo_referencia = $("input.tipo_referencia").eq(index).val();

                $.get("@Url.Action("Desplegar_Bateria", "Evaluacion_Referencia")",
                    {
                        id_referencia :id_referencia,
                        nombre_socio :nombre_socio,
                        telefono_referencia :telefono_referencia,
                        telefono_disponible: telefono_referencia,
                        tipo_referencia : tipo_referencia
                    },
                    function (bateria_preguntas) {
                        $("div.detalle_pregunta").html(bateria_preguntas);
                        Responder_Bateria();
                        Refrescar_Pagina();
                    });
            });
        });
    }

    function Refrescar_Pagina(){
        $("#modal_pregunta").on("hidden.bs.modal", function (e) {
            window.location.reload();
        });
    }
</script>