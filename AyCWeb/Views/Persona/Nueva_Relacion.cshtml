@using DevExtreme.AspNet.Mvc
@model ModelNucleo.Model.Persona_Relaciones

<form id="nueva_relacion_declarado">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" name="id_persona" value="@ViewBag.Id_Persona" />
    <div class="form-group">
        <input type="hidden" asp-for="Id_Sujeto" />
        Nombre: @(Html.DevExtreme().Lookup().ID("Id_Sujeto_LookUp")
                    .ElementAttr("class", "field-customization")
                    .DataSource(
                    d => d.Mvc().Controller("Persona").LoadAction("Personas").Key("Id_Persona")
                    ).DisplayExpr(new JS("lookup_displayExpr")).DisplayValue("Nombres").ValueExpr("Id_Persona")
                    .SearchExpr(new[] { "Nombres", "Apellidos", "Dui", "Id_Persona" })
                    .ItemTemplate(@<text>
                        <div class="custom-item">
                            <div><%= Nombres %> <%= Apellidos %> <%= Dui %></div>
                        </div>
                    </text>).OnSelectionChanged("Obtener_Sujeto")
        )
    </div>
    <div class="form-group">
        <input type="hidden" asp-for="Id_Predicado" />
        Relacionado con: @(Html.DevExtreme().Lookup().ID("Id_Predicado_LookUp")
        .ElementAttr("class", "field-customization")
        .DataSource(
        d => d.Mvc().Controller("Persona").LoadAction("Personas").Key("Id_Persona")
        ).DisplayExpr(new JS("lookup_displayExpr")).DisplayValue("Nombres").ValueExpr("Id_Persona")
        .SearchExpr(new[] { "Nombres", "Apellidos", "Dui", "Id_Persona" })
        .ItemTemplate(@<text>
                    <div class="custom-item">
                        <div><%= Nombres %> <%= Apellidos %> <%= Dui %></div>
                    </div>
        </text>).OnSelectionChanged("Obtener_Predicado")
        )
    </div>
    <div class="form-group">
        <label asp-for="Id_Tipo_Relacion" class="control-label">Tipo Relación</label>
        <select asp-for="Id_Tipo_Relacion" asp-items="@ViewBag.Id_Tipo_Relacion" class="form-control"></select>
        <span asp-validation-for="Id_Tipo_Relacion" class="text-danger"></span>
    </div>
    <div class="form-group">
        <div class="checkbox">
            <label>
                <input asp-for="Activo" /> @Html.DisplayNameFor(model => model.Activo)
            </label>
        </div>
    </div>
    @*<div class="form-group">
        <input type="button" value="Guardar" class="btn btn-default" />
    </div>*@
</form>
