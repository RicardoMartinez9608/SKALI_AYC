@using DevExtreme.AspNet.Mvc


<div class="panel panel-default">
    <div class="panel-heading">Agregar codeudor</div>
    <div class="panel-body">
        <form id="nueva_relacion_declarado">
            <div class="form-group">
                <input type="hidden" id="Id_Sujeto" name="Id_Sujeto" />
                <input type="hidden" id="Id_Tipo_Relacion" name="Id_Tipo_Relacion" value="5" />
                <input type="hidden" id="Id_Credito" name="Id_Credito" />
                <input type="hidden" id="Id_Predicado" name="Id_Predicado" />
                Codeudor: @(Html.DevExtreme().Lookup().ID("Id_Predicado_LookUp")
                .ElementAttr("class", "field-customization")
                .DataSource(
                d => d.Mvc().Controller("Persona").LoadAction("Personas").Key("Id_Persona")
                ).DisplayExpr(new JS("lookup_predicado")).DisplayValue("Nombres").ValueExpr("Id_Persona")
                .SearchExpr(new[] { "Nombres", "NombreCompleto" ,"Apellidos", "Dui", "Id_Persona" })
                .ItemTemplate(@<text>
                        <div class="custom-item">
                            <div><%= Nombres %> <%= Apellidos %> <%= Dui %></div>
                        </div>
                </text>).OnSelectionChanged("Obtener_Predicado")
                )
            </div>

            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input id="Activo" type="checkbox" name="Activo" /> Activo
                    </label>
                </div>
            </div>
        </form>
    </div>
    <div class="panel-footer">
        <input type="button" id="Guardar_Relacion_Principal" class="btn btn-default" value="Guardar" />
    </div>
</div>
<p></p>
<div class="panel panel-default">
    <div class="panel-heading">Codeudores</div>
    <div id="lista_codeudores"></div>
</div>