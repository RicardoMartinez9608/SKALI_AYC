@model IEnumerable<ModelNucleo.Model.Referencia_Bancaria>
@using ModelNucleo.Model
<div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>
                        Tipo Referencia
                    </th>
                    <th>
                        Institución
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Enum.GetValues(typeof(Tipo_Referencia_Num)).GetValue(Convert.ToInt32(item.Tipo_Referencia))
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Institucion)
                        </td>
                        <td>
                            <input type="hidden" value="@item.Id_Referencia_Bancaria" class="id_referencia_bancaria" />
                            <a href="#" class="editar_referencia_bancaria btn btn-default"><span class="glyphicon glyphicon-edit"></span> Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
</div>