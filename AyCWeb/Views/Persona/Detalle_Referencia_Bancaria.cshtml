@model ModelNucleo.Model.Referencia_Bancaria


    <div class="row" id="FormRefenciaBancariaDetalle">
        <div class="col-md-4">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="Id_Referencia_Bancaria" type="hidden" />
                <input asp-for="Id_Persona" type="hidden" />

                <div class="form-group">
                    <label asp-for="Tipo_Referencia" class="control-label">Tipo referencia</label>
                    @Html.DropDownList("Tipo_Referencia", null, htmlAttributes: new { @class = "form-control" })
                    <span asp-validation-for="Tipo_Referencia" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Institucion" class="control-label">Institución</label>
                    <input asp-for="Institucion" class="form-control" />
                    <span asp-validation-for="Institucion" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <button class="btn btn-default " id="guardar_edicion_referencia_bancaria">
                        <span class="glyphicon glyphicon-floppy-disk"></span> Guardar
                    </button>
                </div>

        </div>
    </div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
