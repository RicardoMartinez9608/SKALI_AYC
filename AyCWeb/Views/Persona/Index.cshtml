    function Guardar_Referencia_Adicional(esNuevo) {
        $("button.guardarReferencia_adicional").click(function () {
            var referencia_adicional = $("#formReferenciaAdicionalContent").serializeAnything();
            var metodo = "";
            if (esNuevo)
                metodo = "@Url.Action("CrearReferenciaAdicional", "Persona")";
            else
                metodo = "@Url.Action("EditarReferenciaAdicional", "Persona")";

            $.post(
                metodo,
                referencia_adicional,
                function (resultado) {
                    alertify.success("La referencia adicional ha sido guardado");
                    Cargar_Referencia_Adicional_Lista();
                }).fail(function (error) {
                    alertify.error("No se pudo guardar esta referencia adicional");
                });
        });
    }

