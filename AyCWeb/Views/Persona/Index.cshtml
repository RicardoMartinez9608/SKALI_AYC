<script>

    function Mapa() {
        $("div.Cargar_Mantenimiento").html("");
        $("div.Cargar_Mantenimiento").append("<div id='map' style='width: 714px; height: 400px;'></div>");
    }

    function ObtenerMapa() {
        $("#mapa_coordenadas_domicilio").click(function () {
            Mapa();
            Cargar_Mapa($("#Latitud_Domicilio"), $("#Longitud_Domicilio"));
        });
        $("#mapa_coordenadas_direccion_trabajo").click(function () {
            Mapa();
            Cargar_Mapa($("#Latitud_Direccion_Trabajo"), $("#Longitud_Direccion_Trabajo"));
        });
        $("#mapa_coordenadas_direccion_negocio").click(function () {
            Mapa();
            Cargar_Mapa($("#Latitud_Direccion_Negocio"), $("#Longitud_Direccion_Negocio"));
        });
    }

    function Cargar_Mapa($lat, $long) {
        latitud_domicilio = $lat.val();
        longitud_domicilio = $long.val();
        var coordenadas = new Array();
        if (latitud_domicilio.length > 0 && longitud_domicilio.length > 0) {
            coordenadas = [latitud_domicilio, longitud_domicilio];
        } else {
            coordenadas = [13.979440968359626, -89.68839574121091];
        }
        var mymap = L.map('map', {
            center: coordenadas,
            minZoom: 2,
            zoom: 13,
            maxZoom: 18
        });

        setTimeout(function () { mymap.invalidateSize(true) }, 300);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            //maxZoom: 18,
            attribution: 'Map data © <href="http://openstreetmap.org">OpenStreetMap</a> contributors',
            id: 'mapbox.streets',
            format:"jpg70"
        }).addTo(mymap);
        //mymap.setView(coordenadas,12);
        var marker = L.marker(coordenadas, { draggable: true });
        marker.on('dragend', function (e) {
            $lat.val(marker.getLatLng().lat);
            $long.val(marker.getLatLng().lng);
        });
        marker.addTo(mymap);

        //mymap.fireEvent('load');
        
    }
    function MostrarAmortizacion() {
        /*obtener los datos de linea de crédito*/
        var lineaCredito = $("#Id_Linea").val();
        location.target = "_blank";
        var descripcion = $("#Id_Linea option:selected").text();
        var interes = $("#Tasa_Interes").val();
        var id_linea = lineaCredito;
        var monto = $("#Monto_pago").val();
        var id_periodo = $("#Id_Periodo").val();
        var plazo = $("#Plazo").val();
        var id_credito = $("#form_credito #Id_Credito").val();
        var numero_cuotas = $("#Numero_cuotas").val();

        var enlace = document.getElementById("amortizacion_pdf");
        enlace.href = "@Url.Action("Amortizacion","Reporteria")?id_linea=" + id_linea + "&monto=" + monto + "&id_periodo=" + id_periodo + "&plazo=" + plazo + "&numero_cuotas=" + numero_cuotas+"&descripcion_linea="+descripcion+"&interes="+interes;
        enlace.target = "_blank";
       // enlace.click();
    }

</script>
