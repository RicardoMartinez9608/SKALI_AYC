    function Toma_decision_Referencia() {
        if ($("#Esta_Estudiando").is(":checked")) {
            $("#contenido_estudiante").css("display", "block");
            //$("#contenido_empleo").css("display", "none");
            $("#Esta_Trabajando").checked = false;
        } else {
            $("#contenido_estudiante").css("display", "none");
            //$("#contenido_empleo").css("display", "block");
        }

        if ($("#Esta_Trabajando").is(":checked")) {
            $("#contenido_empleo").css("display", "block");
            //$("#contenido_estudiante").css("display", "none");
            $("#Esta_Estudiando").checked = false;
        } else {
            $("#contenido_empleo").css("display", "none");
            //$("#contenido_estudiante").css("display", "block");
        }
    }


