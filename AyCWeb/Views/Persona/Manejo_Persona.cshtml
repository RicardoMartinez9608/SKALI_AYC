<script>

    $(function() {
        Validar();
    });

    function Validar() {
        $("a.imprimir_accion_persona").click(function() {
            var id_persona = $("#Id_Persona").val();
            $.get("@Url.Action("Consultar_Accion", "Accion")",
                { id_persona: id_persona },
                function() {
                    Imprimir_Accion(id_persona);
                }).fail(function(error) {
                alertify.error("El cliente no tiene acciones");
            });
        });
    }
    function Imprimir_Accion(id_persona) {
        window.open("@Url.Action("Consultar_Accion", "Accion")?id_persona=" + id_persona);
    }
</script>