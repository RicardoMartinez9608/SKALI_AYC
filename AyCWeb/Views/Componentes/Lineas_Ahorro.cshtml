@model IEnumerable<ModelNucleo.Model.Linea_Ahorro>

    <select name="Id_Linea_Ahorro" id="Id_Linea_Ahorro" class="form-control">
        <option value="0">Seleccione una Línea de ahorro</option>
        @foreach (var item in Model)
        {
            <option value="@item.Id_Linea_Ahorro">@item.Descripcion</option>
        }
    </select>
