<div class="row">

    <div class="col-md-4">
        <div class="form-group">
            <strong>Efectivo </strong> <span id="NComprobante"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <strong>Cambio </strong> <span id="NComprobante"></span>
        </div>
    </div>
</div>
<div class="row" >
    <div class="col-md-12" >
        <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <input class="form-control" id="efectivo" type="number" placeholder="Efectivo" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <input class="form-control" id="cambio" type="number" placeholder="Cambio" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <input type="submit" value="Calcular" class="btn btn-primary Calcular_Cambio" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <input type="submit" value="Cerrar" class="btn btn-primary Cerrar_Calculadora" />
                    </div>
                </div>
        </div>
    </div>
    <br/>
   
</div>
