<input type="hidden" id="ids" />

<div class="modal fade" id="Mantenimiento">
    <div class="modal-dialog" style="width:40%">
        <div class="modal-content">

            <div class="modal-header">
                <a href="#" class="close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                    <span class="sr-only">Cerrar</span>
                </a>
                <h4 class="modal-title">Recargos</h4>
            </div>

            <div class="modal-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Fecha</th>
                            <th>Recargo</th>
                            <th>Condonar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecargoCondonacionVista)
                       {
                            <tr>
                                <td>@item.No</td>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@item.Recargo.ToString("C")</td>
                                <td>
                                    @if (item.Cubierto)
                                    {
                                        <input type="hidden" class="id_amortizacion" value="@item.Id_Amortizacion">
                                        <input type="hidden" class="recargo" value="@item.Recargo">
                                        <input type="checkbox" name="condonar" class="btn btn-default condonacion_cuota" value="@item.Condonar" />
                                    }
                                </td>
                            </tr>
                       }
                    </tbody>
                </table>
            </div> <!-- /.modal-body -->

        </div>
    </div>
</div>
@section Scripts{
    <script>
        $(function(){
            $("a.ver_detalle").hide();
            ToggleSeleccionarRecargos();
            AgregarCondonar();
        });

        function ToggleSeleccionarRecargos()
        {
            $("#Condonar_Recargos").click(function(){
                if($("#Condonar_Recargos").is(':checked'))
                {
                    $("a.ver_detalle").show();
                }
                else
                    $("a.ver_detalle").hide();
            });
        }

        function AgregarCondonar()
        {
            $("input.condonacion_cuota").click(function(){
                $("#Valor_Dinero_Recargos").val("");
                $("#ids").val("");
                var suma_condonacion = 0;
                var ids=[];
                $("input.condonacion_cuota").each(function(index){
                    if($('input.condonacion_cuota').eq(index).is(':checked'))
                    {
                        suma_condonacion += Number($("input.recargo").eq(index).val());
                        var id=$('input.id_amortizacion').eq(index).val();
                        ids.push(id);
                    }
                });
                $("#Valor_Dinero_Recargos").val(suma_condonacion);
                $("#ids").val(ids);
            });
            ProcesarCondonacion();
        }

        function ProcesarCondonacion()
        {
            $("#procesar").click(function(){
                if($("#Condonar_Recargos").is(':checked'))
                {
                    var ids=$("#ids").val();
                    var recargo = $("#Valor_Dinero_Recargos").val();
                    $.post("@Url.Action("ProcesarCondonacion","Condonacion")",
                    {
                        ids:ids,
                        recargo:recargo
                    },
                    function(resultado){
                        alertify.success(resultado);
                    }).fail(function (error) {
                        alertify.error(error.responseText);
                    });
                    ResetAll();
                }
            });
        }

        function ResetAll()
        {
            $("#Condonar_Recargos").prop("checked",false);
            $("#Valor_Dinero_Recargos").val("");
            $("input.condonacion_cuota").prop("checked",false);
        }

    </script>
}