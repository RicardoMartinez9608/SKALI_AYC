@model ModelNucleo.Model.Configuracion_General

@{
    ViewData["Title"] = "Detalle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">Editar configuración</div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                <form asp-action="Editar_Configuracion">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input asp-for="Id_Configuracion" class="form-control" type="hidden" />
                    <input asp-for="Nombre" class="form-control" type="hidden" />
                    <input asp-for="Tipo" class="form-control" type="hidden" />

                    <div class="form-group">
                        Variable: @Model.Nombre
                    </div>
                    <div class="form-group">
                        Tipo: @Model.Tipo
                    </div>
                    <div class="form-group">
                        <label asp-for="Valor" class="control-label"></label>
                        <input asp-for="Valor" class="form-control" />
                        <span asp-validation-for="Valor" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Guardar" class="btn btn-default" />
                    </div>
                </form>
            </div>
        </div>

        <div>
            <a asp-action="Index">Regresar a la lista</a>
        </div>
    </div>
</div>