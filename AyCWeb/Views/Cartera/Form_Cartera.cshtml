@model ModelNucleo.Model.Cartera

<div class="row">
    <div class="col-md-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" id="Id_Agencia" value="@ViewBag.Id_Agencia" />
            <div class="form-group">
                <label asp-for="Id_Usuario" class="control-label">Usuario</label>
                <div class="lista_usuario"></div>
            </div>
            <div class="form-group">
                <label asp-for="Nombre" class="control-label">Nombre de la cartera</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
    </div>
</div>
