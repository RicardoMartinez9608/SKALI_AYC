@model ModelNucleo.Model.Menu_Contenido_Vista

<h4>Editar Contenidos</h4>

<div class="row">
    <div class="col-md-12">
        <form id="detalle_contenido">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                @*<label asp-for="Id_Menu_Contenido_Vista" class="control-label"></label>*@
                <input asp-for="Id_Menu_Contenido_Vista" class="form-control" type="hidden" />
                <span asp-validation-for="Id_Menu_Contenido_Vista" class="text-danger"></span>
            </div>
            <div class="form-group">
                @*<label asp-for="Id_Menu_Categoria_Vista" class="control-label"></label>*@
                <input asp-for="Id_Menu_Categoria_Vista" class="form-control" type="hidden" />
                <span asp-validation-for="Id_Menu_Categoria_Vista" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <div class="form-group">
                    <label asp-for="Titulo" class="control-label"></label>
                    <input asp-for="Titulo" class="form-control" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Controller" class="control-label"></label>
                    <input asp-for="Controller" class="form-control" />
                    <span asp-validation-for="Controller" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-5">
                <div class="form-group">
                    <label asp-for="Action" class="control-label"></label>
                    <input asp-for="Action" class="form-control" />
                    <span asp-validation-for="Action" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Icono" class="control-label"></label>
                    <input asp-for="Icono" class="form-control" />
                    <span asp-validation-for="Icono" class="text-danger"></span>
                </div>

            </div>
            <div class="col-md-2">
                <hr />
                <hr />
                <hr />
                <hr />
                <div class="form-group">
                    <input type="button" value="Guardar" class="btn btn-default" id="guardar_edicion_contenido" />
                </div>
            </div>

        </form>
        <div class="cargar_roles"></div>
        <div class="roles_agregados"></div>
    </div>
</div>



