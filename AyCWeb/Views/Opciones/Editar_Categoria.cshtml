@model ModelNucleo.Model.Menu_Categoria_vista

<h4>Editar Categorias</h4>

<div class="row">
    <div class="col-md-12">
        <form id="detalle_categoria">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                @*<label asp-for="Id_Menu_Categoria_Vista" class="control-label"></label>*@
                <input asp-for="Id_Menu_Categoria_Vista" class="form-control" type="hidden" />
                <span asp-validation-for="Id_Menu_Categoria_Vista" class="text-danger"></span>
            </div>
            <div class="col-md-6">

                <div class="form-group">
                    <label asp-for="Titulo" class="control-label"></label>
                    <input asp-for="Titulo" class="form-control" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Nivel" class="control-label"></label>
                    <input asp-for="Nivel" class="form-control" />
                    <span asp-validation-for="Nivel" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">

                <div class="form-group">
                    <label asp-for="Icono" class="control-label"></label>
                    <input asp-for="Icono" class="form-control" />
                    <span asp-validation-for="Icono" class="text-danger"></span>
                </div>
                <div class="form-group">

                    <hr />
                    <input type="button" value="Guardar" class="btn btn-default" id="guardar_edicion_categoria" />
                </div>
            </div>
        </form>
        <div class="cargar_roles"></div>
        <div class="roles_agregados"></div>
    </div>
</div>



