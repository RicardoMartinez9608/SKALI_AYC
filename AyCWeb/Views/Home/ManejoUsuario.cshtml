<ul class="nav navbar-nav navbar-right">
    <li class="dropdown">
        @{
            if (!string.IsNullOrEmpty(ViewBag.Usuario))
            {
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">@ViewBag.Usuario <span class="caret"></span></a>
                <ul class="dropdown-menu">
                    <li> @Html.ActionLink("Cambiar Contraseña", "CambiarContrasena","Home", new { id_usuario = ViewBag.Usuario }) </li>
                    <li role="separator" class="divider"></li>
                    <li><a href="@Url.Action("LogOut","Home")">Cerrar sesión</a></li>
                </ul>
            }
            else
            {
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Sesión<span class="caret"></span></a>
                <ul class="dropdown-menu">
                    <li><a href="@Url.Action("Login","Home")">Iniciar sesión</a></li>
                </ul>
            }
        }

    </li>
</ul>