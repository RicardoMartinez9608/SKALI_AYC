@{
    ViewData["Title"] = "Agregar Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">Agregar Roles a @ViewBag.Usuario</div>
    <div class="panel-body panel-body-personalizado">
        <input type="hidden" value="@ViewBag.Usuario" class="usuario"/>
        <p>
            Roles:
            <div class="row">
                <div class="col-md-4">
                    @Html.DropDownList("Rol", null, String.Empty, new {@class = "form-control rol"})
                </div>
            </div>
        </p>
        <div class="listaRoles"></div>
        <p>
            Nombre Real:
            <div class="row">
                <div class="col-md-4">
                    <div class="input-group">
                        <input type="text" class="form-control" name="Nombre_Completo" id="Nombre_Completo" />
                        <span class="input-group-btn">
                            <input type="button" class="btn btn-default" value="Guardar" id="Guardar_Nombre_Real" />
                        </span>
                    </div>
                </div>
            </div>
        </p>
        <p>
            Asignar Agencia
            <div class="listaAgencia"></div>
        </p>
    </div>
</div>


@section Scripts {
    <script>

        function ListaAgencias() {
            $.get("@Url.Action("Agencias_Radio", "Componentes")",
                function(agencias) {
                    $(".listaAgencia").html(agencias);
                    AgenciaAsignada();
                    AsignarAgencia();
                    Nombre_Real_Usuario();
                });
        }

        function Nombre_Real_Usuario() {
            $("#Guardar_Nombre_Real").click(function () {
                alertify.confirm('Confirmación', '¿Quieres cambiar el nombre del usuario?',
                        function() {
                            $.get("@Url.Action("Nombre_Real_Usuario", "Home")",
                                {
                                    usuario: $(".usuario").val(),
                                    nombre_completo: $("#Nombre_Completo").val()
                                },
                                function(resuelto) {
                                    alertify.success(resuelto);
                                }).fail(function (error) {
                                    alertify.error(error.responseText);
                                });
                        },
                        function() {
                            alertify.error('Operación Cancelada');
                        });
            });
        }

        function AsignarAgencia() {
            $(".id_agencia").each(function(index) {
                $(".id_agencia").eq(index).click(function() {
                    alertify.confirm('Confirmación', '¿Quieres cambiar la agencia de usuario?',
                        function() {
                            $.get("@Url.Action("AsignarAgencia", "Home")",
                                {
                                    usuario: $(".usuario").val(),
                                    nombre_completo: $("#Nombre_Completo").val(),
                                    id_agencia: $(".id_agencia").eq(index).val()
                                },
                                function(resuelto) {
                                    alertify.success(resuelto);
                                }).fail(function (error) {
                                    alertify.error(error.responseText);
                                });
                        },
                        function() {
                            alertify.error('Operación Cancelada');
                        });

                });
            });
        }

        function AgenciaAsignada() {
            $.get("@Url.Action("AgenciaAsignada", "Home")",
                { usuario: $(".usuario").val() },
                function(asignado) {
                    $(".id_agencia").each(function(index) {
                        var id_agencia = parseInt($(".id_agencia").eq(index).val());
                        var id_asignado = parseInt(asignado);
                        if (id_asignado == id_agencia)
                            $(".id_agencia").eq(index).attr("checked", "checked");
                    });
                });
        }

        function ListaRolesAsignados() {
            $.get("@Url.Action("RolesAsignados", "Home")",
                { usuario: $(".usuario").val() },
                function(rolesAsignados) {
                    $(".listaRoles").html(rolesAsignados);
                    /*borrar rol asignado al usuario elegido*/
                    BorrarRolAsignado();
                });
        }

        function BorrarRolAsignado() {
            $(".borrarRol").each(function(index) {
                $(".borrarRol").eq(index).click(function() {
                    alertify.confirm('Confirmación',
                        '¿Quieres Eliminar el Rol de Usuario?',
                        function() {
                            $.post("@Url.Action("BorrarRolAsignado", "Home")",
                                { usuario: $(".usuario").val(), rol: $(".nombreRole").eq(index).val() },
                                function(respuesta) {
                                    ListaRolesAsignados();
                                    alertify.success(respuesta);
                                }).fail(function(error) {
                                alertify.error(error.responseText);
                            });
                        },
                        function() {
                            alertify.error('Operación Cancelada');
                        });

                });
            });
        }

        $(document).ready(function() {
            ListaRolesAsignados();
            ListaAgencias();
        });

        $("#Rol").change(function() {
            var rol = $(this).val();
            var direccion = "@Url.Action("AgregarRol", "Home")";
            alertify.confirm('Confirmación',
                '¿Quieres Cambiar o Agregar Rol de Usuario?',
                function() {
                    $.post(direccion,
                        { usuario: $(".usuario").val(), rol: $(".rol").val() },
                        function(resultado) {
                            ListaRolesAsignados();
                            alertify.success(resultado);
                        }).fail(function(error) {
                        alertify.error(error.responseText);
                    });
                },
                function() {
                    alertify.error('Operación Cancelada');
                });

        });
    </script>
}
