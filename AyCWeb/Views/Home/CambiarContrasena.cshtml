@model ModelNucleo.Model.ModelView.CambiarContrasenaAdmin
@{
    ViewData["Title"] = "Cambiar Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">Cambiar Contraseña de @ViewBag.Id_Usuario</div>
    <div class="panel-body">
        @*<form asp-action="CambiarContrasena">*@
        <form id="contrasena">
            <div class="form-group">
                <label asp-for="Id_Usuario" class="control-label">Usuario</label>
                <input asp-for="Id_Usuario" class="form-control" />
                <span asp-validation-for="Id_Usuario" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Contrasena" class="control-label" for="pswd">Contraseña</label>
                <input asp-for="Contrasena" class="form-control limpiar" />
                <span asp-validation-for="Contrasena" class="text-danger" id="pswd" type="password" name="pswd"></span>
                <div id="pswd_info">
                    <h4>La Contraseña debe cumplir con los siguientes requisitos:</h4>
                    <ul>
                        <li id="letter" class="invalid"><strong>Al menos una letra</strong></li>
                        <li id="capital" class="invalid"><strong>Al menos una letra Mayuscula</strong></li>
                        <li id="number" class="invalid"><strong>Al menos un número</strong></li>
                        <li id="length" class="invalid"><strong>Minimo 6 caracteres</strong></li>
                    </ul>
                </div>
            </div>

            <div class="form-group ">
                <input type="button" value="Cambiar" class="btn btn-default " id="guardar_edicion_contraseña" />
            </div>
        </form>
        @*</form>*@
    </div>
 
</div>
