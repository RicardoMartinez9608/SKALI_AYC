@model IEnumerable<ModelNucleo.Model.Menu_Categoria_vista>
  
@if (Model != null)
{


@foreach (var item in Model)
{
    @if (item != null)
    {
        <li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                @item.Titulo<span class="caret"></span>
            </a>
            <ul class="dropdown-menu multi-level" role="menu" aria-labelledby="dropdownMenu">
                @if (item.Menu_Contenido!=null)
                {
                    @foreach (var content in item.Menu_Contenido)
                    {
                        <li>
                            <a asp-area="" asp-controller="@content.Controller" asp-action="@content.Action"><span class="glyphicon @content.Icono"></span> @content.Titulo</a>
                        </li>
                    }
                }
            </ul>
        </li>
    }
}
}