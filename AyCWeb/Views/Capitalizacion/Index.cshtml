            function EjecutarCapitalizacion() {

        $("#EjecutarCapitalizacion")
            .off("click")
            .on("click", function () {

                var excluidos = [];

                var incluidos = 0;

                $("table tbody tr").each(function () {

                    if ($(this).attr("data-excluido") === "true") {

                        excluidos.push(
                            $(this)
                                .find(".nombre-ahorrante")
                                .text()
                        );
                    }
                    else {
                        incluidos++;
                    }

                });

                var html = "";

                html += "<p><strong>Cuentas a procesar:</strong> "
                    + incluidos + "</p>";

                html += "<p><strong>Cuentas excluidas:</strong> "
                    + excluidos.length + "</p>";

                if (excluidos.length > 0) {

                    html += "<hr>";

                    html += "<p><strong>Excluidos:</strong></p>";

                    html += "<ul>";

                    excluidos.forEach(function (nombre) {

                        html += "<li>" + nombre + "</li>";

                    });

                    html += "</ul>";
                }

                $("#resumenCapitalizacion").html(html);

                $("#modalConfirmacionCapitalizacion").modal("show");

            });

    }
        $("#btnConfirmarCapitalizacion").click(function () {

        $("#modalConfirmacionCapitalizacion").modal("hide");

        var lista_pagos = [];

        var fechaSeleccionada = $("#fecha").val();

        $("table tbody tr").each(function () {

            if ($(this).attr("data-excluido") === "true") {
                return true;
            }

            var id = $(this).data("id");

            var valor = parseFloat(
                $(this)
                    .find(".valor-capitalizar")
                    .val()
            ) || 0;

            lista_pagos.push({
                IdAhorro: id,
                Valor: valor,
                Fecha: fechaSeleccionada
            });

        });

        $.ajax({

            type: "POST",

            url: urlEjecutarTraslados,

            contentType: "application/json; charset=utf-8",

            data: JSON.stringify(lista_pagos),

            beforeSend: function () {

                blockUI("Ejecutando capitalización...");

                $("#EjecutarCapitalizacion")
                    .prop("disabled", true);

                // $("#mensajeCapitalizacion")
                //     .html("<div class='alert alert-warning'>Procesando...</div>");
            },

            success: function (Respuesta) {

                unblockUI();

                $("#mensajeCapitalizacion")
                    .html("<div class='alert alert-success'>" +
                        Respuesta +
                        "</div>");

                alertify.success(Respuesta);
            },

            error: function () {

                unblockUI();

                $("#EjecutarCapitalizacion")
                    .prop("disabled", false);

                alertify.error(
                    "Error al ejecutar la capitalización"
                );
            }

        });

    });
        function blockUI(mensaje) {
            if (mensaje) {
                $("#blockUI p").text(mensaje);
            }
            $("#blockUI").fadeIn(200);
        }

    function unblockUI() {
        $("#blockUI").fadeOut(200);
    }

        $(document).on("click", ".excluir-registro", function () {

        var fila = $(this).closest("tr");

        var boton = $(this);

        if (!fila.hasClass("fila-excluida")) {

            fila.addClass("fila-excluida");

            fila.attr("data-excluido", "true");

            fila.find(".estado-capitalizacion")
                .html("<span class='label label-danger'>Excluido</span>");

            boton
                .removeClass("btn-warning")
                .addClass("btn-success")
                .text("Incluir");
        }
        else {

            fila.removeClass("fila-excluida");

            fila.removeAttr("data-excluido");

            fila.find(".estado-capitalizacion")
                .html("<span class='label label-success'>Incluido</span>");

            boton
                .removeClass("btn-success")
                .addClass("btn-warning")
                .text("Excluir");
        }

    });
        
