@model List<ModelNucleo.Model.Bitacora>

@{
    Layout = null;
    var tipo = ViewBag.Tipo ?? "todos";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        body {
            font-family: Arial;
            font-size: 12px;
        }

        h2 {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #000;
            padding: 5px;
        }

        th {
            background-color: #eee;
        }

        .ok {
            color: green;
        }

        .error {
            color: red;
        }
    </style>
</head>
<body>

    <h2>Reporte DTE (@tipo)</h2>

    <table>
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Codigo</th>
                <th>Cliente</th>
                <th>Detalle</th>
                <th>Monto</th>
                <th>Usuario</th>
            </tr>
        </thead>
        <tbody>
            @{
                decimal total = 0;
            }

            @foreach (var item in Model)
            {
                total += item.Monto_Afectado;

                var clase = item.Proceso.Contains("error") ? "error" : "ok";

                <tr class="@clase">
                    <td>@item.Fecha_Proceso.ToString("dd/MM/yyyy")</td>
                    <td>@item.Codigo</td>
                    <td>@item.Cliente</td>
                    <td>@item.Proceso</td>
                    <td>@item.Monto_Afectado.ToString("C")</td>
                    <td>@item.Id_Usuario</td>
                </tr>
            }
        </tbody>
    </table>

    <br />

    <h3 style="text-align:right;">Total: @total.ToString("C")</h3>

</body>
</html>