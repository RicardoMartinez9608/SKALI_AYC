@using ModelNucleo.Model.ModelView
@model ModelNucleo.Model.ModelView.Reporte_Vista<IEnumerable<ModelNucleo.Model.ModelView.Reporte_General_Credito>>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <link href="~/css/Reporte.css" rel="stylesheet" />
    <meta name="viewport" content="width=device-width" />
    <title>Reporte de Generales Crédito</title>
</head>
<body>
     <table align="center">
        <thead>
            <tr>
                <td style="width: 199px">
                    <h6 align="left"> emision: @ViewBag.emision @ViewBag.usuario</h6>
                </td>
                <th style="width: 450px">
                    <h2 align="center"> @ViewBag.nombreEmpresa</h2>
                </th>
                <td style="width: 200px">
                </td>
            </tr>
        </thead>
    </table>
    
    <h3 align="center">Reporte de Generales Desde @Model.Encabezado.Fecha_Inicio Hasta @Model.Encabezado.Fecha_Final</h3>



    @foreach (var reporte in Model.Contenido)
    {
        <h3 align="left">Agencia: @reporte.Nombre_agencia</h3>
        <table class="greyGridTable">
            <thead>

                <tr>
                    <th colspan="3"></th>
                    <th colspan="3" style="border-bottom:1px solid #000000">Nuevos Créditos</th>
                    <th colspan="1"></th>
                    <th colspan="1"></th>
                    <th colspan="2" style="border-bottom:1px solid #000000">Clientes</th>
                    <th colspan="1"></th>
                    <th colspan="7" style="border-bottom:1px solid #000000">Datos de Mora</th>

                </tr>

                <tr>
                    <th>
                        Cartera
                    </th>
                    <th>
                        Asesor
                    </th>
                    <th>
                        Colocación
                    </th>

                    <th>
                        <p>N Crédito</p>
                    </th>
                    <th>
                        <p>Recuperado</p>
                    </th>
                    <th>
                        <p>Recurrente</p>
                    </th>
                    <th>
                        V Cartera
                    </th>
                    <th>
                        Créditos
                    </th>
                    <th>
                        Cliente Activo
                    </th>
                    <th>
                        inactivos
                    </th>
                    <th>
                        Ca Recuperado
                    </th>
                    <th>
                        Ca Mora
                    </th>
                    <th>
                        Colecta
                    </th>
                    <th>
                        Índice
                    </th>
                    <th>
                        Crédito Mora
                    </th>
                    <th>
                        Cliente Mora
                    </th>
                    <th>
                        Cliente Vencido
                    </th>
                    <th>
                        Vencidos
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in reporte.Generales)
                {
                    <tr>
                        <td align="right">
                            @item.No_Cartera
                        </td>
                        <td>
                            @item.Nombre_Asignado
                        </td>
                        <td align="right">
                            @item.Colocacion.ToString("C")
                        </td>
                        <td align="right">
                            @item.Nuevos_Creditos
                        </td>
                        <td align="right">
                            @item.Recuperados
                        </td>
                        <td align="right">
                            @item.Recurrentes
                        </td>
                        <td align="right">
                            @item.Valor_Cartera.ToString("C")
                        </td>
                        <td align="right">
                            @item.Creditos
                        </td>
                        <td align="right">
                            @item.Clientes_Activos
                        </td>
                        <td align="right">
                            @item.Clientes_Inactivos
                        </td>
                        <td align="right">
                            @item.Capital_Recuperado.ToString("C")
                        </td>
                        <td align="right">
                            @item.Capital_Mora.ToString("C")
                        </td>
                        <td align="right">
                            @item.Colecta.ToString("p")
                        </td>
                        <td align="right">
                            @item.Indice.ToString("p")
                        </td>
                        <td align="right">
                            @item.Creditos_Mora
                        </td>
                        <td align="right">
                            @item.Clientes_Mora
                        </td>
                        <td align="right">
                            @item.Clientes_Vencidos
                        </td>
                        <td align="right">
                            @item.Vencidos.ToString("p")
                        </td>
                    </tr>
                }


                <tr>
                    <td>
                    </td>
                    <td>
                        TOTAL
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(c => c.Colocacion).ToString("C")
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Nuevos_Creditos)
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Recuperados)
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Recurrentes)
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Valor_Cartera).ToString("C")
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Creditos)
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Clientes_Activos)
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Clientes_Inactivos)
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Capital_Recuperado).ToString("C")
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Capital_Mora).ToString("C")
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Colecta).ToString("p")
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Indice).ToString("p")
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Creditos_Mora)
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Clientes_Mora)
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Clientes_Vencidos)
                    </td>
                    <td align="right">
                        @reporte.Generales.Sum(n => n.Vencidos).ToString("p")
                    </td>

                </tr>

            </tbody>
        </table>
    }
    <br />
    <br />
    @if (Model.Contenido.Count() > 1)
    {
        <h3 align="left">Totales Generales</h3>
        <table class="greyGridTable">
            <thead>

                <tr>
                    <th colspan="3"></th>
                    <th colspan="3" style="border-bottom:1px solid #000000">Nuevos Créditos</th>
                    <th colspan="1"></th>
                    <th colspan="1"></th>
                    <th colspan="2" style="border-bottom:1px solid #000000">Clientes</th>
                    <th colspan="1"></th>
                    <th colspan="7" style="border-bottom:1px solid #000000">Datos de Mora</th>

                </tr>

                <tr>
                    <th>

                    </th>
                    <th>
                        Valor
                    </th>
                    <th>
                        Colocación
                    </th>

                    <th>
                        <p>N Crédito</p>
                    </th>
                    <th>
                        <p>Recuperado</p>
                    </th>
                    <th>
                        <p>Recurrente</p>
                    </th>
                    <th>
                        V Cartera
                    </th>
                    <th>
                        Créditos
                    </th>
                    <th>
                        Cliente Activo
                    </th>
                    <th>
                        inactivos
                    </th>
                    <th>
                        Ca Recuperado
                    </th>
                    <th>
                        Ca Mora
                    </th>
                    <th>
                        Colecta
                    </th>
                    <th>
                        Índice
                    </th>
                    <th>
                        Crédito Mora
                    </th>
                    <th>
                        Cliente Mora
                    </th>
                    <th>
                        Cliente Vencido
                    </th>
                    <th>
                        Vencidos
                    </th>
                </tr>
            </thead>

            <tr>
                <td>
                </td>
                <td>
                    TOTALES GENERALES
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Colocacion)).ToString("C")
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Nuevos_Creditos))
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Recuperados))
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Recurrentes))
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Valor_Cartera)).ToString("C")
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Creditos))
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Clientes_Activos))
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Clientes_Inactivos))
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Capital_Recuperado)).ToString("C")
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Capital_Mora)).ToString("C")
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Colecta)).ToString("C")
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Indice)).ToString("p")
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Creditos_Mora))
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Clientes_Mora))
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Clientes_Vencidos))
                </td>
                <td align="right">
                    @Model.Contenido.Sum(c => c.Generales.Sum(d => d.Vencidos)).ToString("p")
                </td>

            </tr>
        </table>
    }






    <br />
    <br />

    <table cellspacing="10" align="center">
        <thead>
            <tr>
                <th>________________________________</th>
                <th>________________________________</th>
                <th>________________________________</th>
                <th>________________________________</th>
            </tr>

            <tr>
                <th style="text-align:center">Informática</th>
                <th style="text-align:center">Jefe de Agencia</th>

            </tr>

        </thead>

    </table>



</body>
</html>
