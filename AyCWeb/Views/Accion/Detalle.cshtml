@model ModelNucleo.Model.Accion

<form id="detalle_accion">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input asp-for="Id_Accion" type="hidden" class="form-control" />
    <input asp-for="Id_Persona" type="hidden" class="form-control" />
    <input asp-for="No_Certificado" type="hidden" class="form-control" />
    <input asp-for="Codigo" type="hidden" class="form-control" />
    <input asp-for="Valor_Total" type="hidden" class="form-control" />

    <div class="form-group">
        <label asp-for="Cantidad_Accion" class="control-label">Cantidad</label>
        <input asp-for="Cantidad_Accion" class="form-control" />
        <span asp-validation-for="Cantidad_Accion" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Valor_Unitario" class="control-label">Precio unitario</label>
        <input asp-for="Valor_Unitario" class="form-control" />
        <span asp-validation-for="Valor_Unitario" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="button" value="Guardar" id="Guardar_Nueva_Accion" class="btn btn-default" />
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
