@model ModelNucleo.Model.Comite

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Create</h2>

<h4>Comite</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Id_Usuario" class="control-label"></label>
                <input asp-for="Id_Usuario" class="form-control" />
                <span asp-validation-for="Id_Usuario" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Id_Credito" class="control-label"></label>
                <select asp-for="Id_Credito" class ="form-control" asp-items="ViewBag.Id_Credito"></select>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="Ampliado" /> @Html.DisplayNameFor(model => model.Ampliado)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Fecha_Verificado" class="control-label"></label>
                <input asp-for="Fecha_Verificado" class="form-control" />
                <span asp-validation-for="Fecha_Verificado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="Verificado" /> @Html.DisplayNameFor(model => model.Verificado)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="Aprobado" /> @Html.DisplayNameFor(model => model.Aprobado)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Comentario" class="control-label"></label>
                <input asp-for="Comentario" class="form-control" />
                <span asp-validation-for="Comentario" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

