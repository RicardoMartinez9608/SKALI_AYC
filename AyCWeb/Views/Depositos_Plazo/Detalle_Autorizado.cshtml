@model IEnumerable<ModelNucleo.Model.Autorizado>
    <div class="col-lg-12 text-right">
        <a href="#Nuevo_Autorizado_Modal" data-toggle="modal" class="btn btn-default nuevo_autorizado">Nuevo Autorizado</a>
    </div>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>
                Nombre Persona Autorizada
            </th>
            <th>
                DUI
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <input type="hidden" value="@item.Id_Autorizado" class="id_autorizado_deposito" />
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Dui)
            </td>
            <td>
                <button class="btn btn-default Eliminar_Autorizado" type="button">Eliminar</button>
            </td>
            <td>
                <a href="#Editar_Autorizado_Modal" data-toggle="modal" class="btn btn-default Editar_Autorizado" type="button">Editar</a>
            </td>
        </tr>
}
    </tbody>
</table>
<div class="modal" id="Nuevo_Autorizado_Modal">
    <div class="modal-dialog" style="width:80%">
        <div class="modal-content">
            <div class="modal-header">
                <a href="#" class="close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                    <span class="sr-only">Close</span>
                </a>
                <h4 class="modal-title" id="titulo_sub_modal">Autorizado</h4>
            </div>
            <div class="modal-body ">
                <div class="nuevo_autorizado"></div>
            </div>
        </div>
    </div>
</div>
<div class="modal" id="Editar_Autorizado_Modal">
    <div class="modal-dialog" style="width:80%">
        <div class="modal-content">
            <div class="modal-header">
                <a href="#" class="close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                    <span class="sr-only">Close</span>
                </a>
                <h4 class="modal-title" id="titulo_sub_modal">Autorizado</h4>
            </div>
            <div class="modal-body ">
                <div class="editar_nuevo_autorizado"></div>
            </div>
        </div>
    </div>
</div>