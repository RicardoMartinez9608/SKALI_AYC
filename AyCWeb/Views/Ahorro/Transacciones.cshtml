@model IEnumerable<ModelNucleo.Model.ModelView.Transaccion_Ahorro_Vista>
<style>
  .contenedor-transacciones {
    display: flex;
    flex-direction: column;
    height: 350px;
    border: 1px solid #ddd;
    border-radius: 6px;
    background: #fff;
}

.tabla-scroll {
    overflow-y: auto;
    flex: 1;
}

.footer-tabla {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    border-top: 1px solid #eee;
    background: #fafafa;
}

.info-registros {
    font-size: 12px;
    color: #666;
}

.paginacion ul {
    margin: 0;
}
.paginacion {
    max-width: 100%;
    overflow-x: auto;
    white-space: nowrap;
}
.pagination > li > a {
    color: #337ab7;
    border-radius: 4px;
    margin: 0 2px;
}

.pagination > .active > a {
    background-color: #337ab7;
    border-color: #337ab7;
}

</style>
<div class="contenedor-transacciones card-shadow">
    <div class="tabla-scroll">
        <table class="table prueba">
            <thead>
                <tr>
                    <th>
                        No.
                    </th>
                    <th>
                        Fecha
                    </th>
                    <th>
                        Comprobante
                    </th>
                    <th>
                        Caja
                    </th>
                    <th>
                        Depósito
                    </th>
                    <th>
                        Retiro
                    </th>
                    <th>
                        Saldo
                    </th>
                    <th>
                        <input type="checkbox" name="todas_transacciones_ahorro" class="btn btn-default todas_transacciones_ahorro" value="todo" />
                    </th>
                </tr>
            </thead>
            <tbody>
                @{
                    int centinela = 0;
                }
                @foreach (var item in Model)
                {
                    centinela += 1;

                    <tr>
                        <td>
                            @centinela
                        </td>
                        <td>
                            @Html.ValueFor(modelItem => item.Fecha, "{0:dd/MM/yyyy}")
                        </td>
                        <td>

                            @Html.DisplayFor(modelItem => item.Transacciones.No_Comprobante)
                        </td>
                        <td>
                            @if (item.caja != null)
                        @item.caja.Id_Caja
                        
                            </td>
                            <td>
                                @item.Deposito.ToString("C2")
                            </td>
                            <td>
                                @item.Retiro.ToString("C2")
                            </td>

                            <td>
                                @item.Saldo.ToString("C2")
                            </td>
                            <td>
                                <input type="hidden" class="id_transaccion_valor" value="@item.Id">
                                <input type="checkbox" name="transaccion_ahorro" class="btn btn-default transaccion_ahorro" id="id_transaccion" value="@item.Id" />
                            </td>
                        </tr>
                                }
            </tbody>
        </table>
    </div>

@{
    int total = ViewBag.Total;
    int pageSize = ViewBag.PageSize;
    int currentPage = ViewBag.Page;

    int totalPages = (int)Math.Ceiling((double)total / pageSize);
        int startPage = Math.Max(1, currentPage - 2);
        int endPage = Math.Min(totalPages, currentPage + 2);
}

     <div class="footer-tabla">
        <div class="info-registros">
            Mostrando @((currentPage - 1) * pageSize + 1)
            a @(Math.Min(currentPage * pageSize, total))
            de @total registros
        </div>

        <ul class="pagination">

            @if (currentPage > 1)
            {
                <li><a href="#" class="page-link" data-page="@(currentPage - 1)">«</a></li>
            }

            @if (startPage > 1)
            {
                <li><a href="#" class="page-link" data-page="1">1</a></li>
                if (startPage > 2)
                {
                    <li><span>...</span></li>
                }
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="@(i == currentPage ? "active" : "")">
                    <a href="#" class="page-link" data-page="@i">@i</a>
                </li>
            }

            @if (endPage < totalPages)
            {
                if (endPage < totalPages - 1)
                {
                    <li><span>...</span></li>
                }
                <li><a href="#" class="page-link" data-page="@totalPages">@totalPages</a></li>
            }

            @if (currentPage < totalPages)
            {
                <li><a href="#" class="page-link" data-page="@(currentPage + 1)">»</a></li>
            }

        </ul>
         </div>
    </div>
</div>
<ayc-alerta respuesta="ViewBag.Respuesta"></ayc-alerta>