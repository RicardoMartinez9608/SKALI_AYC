@using ModelNucleo.Dto
@model EstadoCuentaDTO
@{
    Layout = null;
    var urlLogo = $"{Context.Request.Scheme}://{Context.Request.Host}/images/logo.png";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        body {
            font-family: 'Segoe UI', Arial;
            font-size: 12px;
            color: #333;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #2c3e50;
            margin-bottom: 20px;
        }

            .header h2 {
                margin: 0;
                color: #2c3e50;
            }

        .info {
            margin-bottom: 20px;
        }

            .info table {
                width: 100%;
            }

            .info td {
                padding: 5px;
            }

        .resumen {
            margin-bottom: 20px;
            background: #f4f6f7;
            padding: 10px;
            border-radius: 5px;
        }

        .tabla {
            width: 100%;
            border-collapse: collapse;
        }

            .tabla th {
                background: #2c3e50;
                color: white;
                padding: 8px;
                text-align: left;
            }

            .tabla td {
                padding: 8px;
                border-bottom: 1px solid #ddd;
            }

            .tabla tr:nth-child(even) {
                background: #f9f9f9;
            }

        .right {
            text-align: right;
        }

        .footer {
            margin-top: 20px;
            font-size: 10px;
            text-align: center;
            color: #777;
        }
    </style>
</head>
<body>
   
    <div style="width:100%; border-bottom:2px solid #2c3e50; padding-bottom:10px; margin-bottom:20px;">

        <table style="width:100%;">
            <tr>
                <td style="width:20%;">
                    <img src="@urlLogo" style="height:70px;" />
                </td>

                <td style="text-align:center;">
                    <h2 style="margin:0; color:#2c3e50;">
                        SOCIEDAD COOPERATIVA
                    </h2>

                    <h3 style="margin:0; color:#34495e;">
                        CRÉDITOS ÁGIL Y CONFIABLE DE R.L.
                    </h3>

                    <p style="margin:0; font-size:12px;">
                        Estado de Cuenta de Ahorro
                    </p>
                </td>

                <td style="width:20%; text-align:right; font-size:11px;">
                    <strong>Fecha emisión:</strong><br />
                    @DateTime.Now.ToString("dd/MM/yyyy")
                </td>
            </tr>
        </table>

    </div>

    <div class="info">
        <table>
            <tr>
                <td><strong>Cliente:</strong> @Model.NombrePersona</td>
                <td><strong>No. Cuenta:</strong> @Model.No_Ahorro</td>
            </tr>
            <tr>
                <td><strong>Desde:</strong> @Model.FechaInicio.ToString("dd/MM/yyyy")</td>
                <td><strong>Hasta:</strong> @Model.FechaFin.ToString("dd/MM/yyyy")</td>
            </tr>
        </table>
    </div>

    <div class="resumen">
        <strong>Saldo Inicial:</strong> @Model.SaldoInicial.ToString("C") <br />
        <strong>Saldo Final:</strong> @Model.SaldoFinal.ToString("C")
    </div>
    @if (!string.IsNullOrEmpty(Model.ImagenArriba))
    {
        <div style="text-align:center; margin-bottom:15px;">
            <img src="@Model.ImagenArriba" style="width:100%; max-width:700px; height:auto;" />
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.TextoPublicidad))
    {
        <div style="margin:15px 0; padding:10px; background:#eaf2f8; border-left:4px solid #3498db;">
            @Model.TextoPublicidad
        </div>
    }
    <table class="tabla">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Operación</th>
                <th class="right">Valor</th>
                <th class="right">Saldo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var mov in Model.Movimientos)
            {
                <tr>
                    <td>@mov.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@mov.TipoOperacion</td>
                    <td class="right">@mov.Valor.ToString("C")</td>
                    <td class="right">@mov.Saldo.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
    @if (!string.IsNullOrEmpty(Model.ImagenAbajo))
    {
        <div style="text-align:center; margin-bottom:15px;">
            <img src="@Model.ImagenAbajo" style="width:100%; max-width:700px; height:auto;" />
        </div>
    }
    <div class="footer">
        Documento generado automáticamente - @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
    </div>

</body>
</html>