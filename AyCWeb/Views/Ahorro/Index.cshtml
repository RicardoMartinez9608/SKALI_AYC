        <script>
            $(function () {
                $("#dui_buscar").mask("00000000-0");
                BuscarPorDui();
                Recalculo();
                Procesar_Recalculo();
                Nuevo_Detalle();
                EstadoCuenta();
            });
            function DataGridPreparada() {
                Ver_Detalle();
             
                Documentos_Legales();
              
            }
            function BuscarPorDui() {
                $("#buscarpordui").click(function () {
                    var filtro = $("#dui_buscar").val();
                    $.get("@Url.Action("JDetalle_Persona","Persona")",
                        { filtro: filtro },
                        function (detalle) {
                            $("span.nombre_completo").text(detalle.nombreCompleto);
                            $("span.dui").text(detalle.dui);
                            $("span.id").text(detalle.id_Persona);
                            var id_persona = $("#id_persona").text();
                            var nombre = $("#nombre").text();
                            var dui = $("#dui_persona").text();
                            if (id_persona != null) {
                                window.location.href = "@Url.Action("Index", "Ahorro")?id_persona=" + id_persona + "&nombre=" + nombre + "&dui=" + dui;
                            }

                        }).fail(function (error) {
                        alertify.error("No se encontró esa identificación");
                    });
                });
            }
            
            function Nuevo_Detalle() {
                $("a.nuevo_ahorro").click(function () {
                    //Refrescar_Modales();
                    $.get("@Url.Action("Ahorro_Manejo", "Ahorro")", { esNuevo: true }, function (perfil) {
                        $("div.detalle_ahorro_detalle").html(perfil);
                        //Select_Linea_Ahorro();
                        Guardar_Ahorro();
                        var id = $("#id_persona").text();
                        $("#Id_Persona").val(id);
                        //Eventos_Inicial();
                        Lista_Firmas_Autorizadas();
                        Nueva_Firma_Autorizada();
                    });
                });
            }

            function Ver_Detalle() {
                $("a.ver_detalle").each(function (index) {
                    $("a.ver_detalle").eq(index).click(function () {
                        $('#MantenimientoRecalculo').modal('hide');

                        var id_ahorro = $(this).closest("td").find("input.id_ahorro_valor").val();

                        if (!id_ahorro) {
                            alertify.error("No se encontró el ID del ahorro seleccionado.");
                            return;
                        }                        //Refrescar_Modales();
                        $.get("@Url.Action("Ahorro_Manejo", "Ahorro")", { esNuevo:false, id_ahorro: id_ahorro }, function (perfil) {
                            $("div.detalle_ahorro_detalle").html(perfil);
                            //Select_Linea_Ahorro();
                            Guardar_Ahorro();
                            Editar_Ahorro();
                            Guardar_Libreta();
                            Ver_NCuenta();
                            Rotulado(id_ahorro);
                            N_Cuenta_Ahorro(id_ahorro);
                            //Eventos_Inicial();
                            Lista_Firmas_Autorizadas();
                            Nueva_Firma_Autorizada();
                        });
                    });
                });
            }

            function Recalculo() {
                // Evitar que se dupliquen los eventos si se vuelve a cargar el grid
                $(document).off('click', '.ver_detallerecalculo');

                // Delegar el evento de clic
                $(document).on('click', '.ver_detallerecalculo', function (e) {
                    e.preventDefault();

                    // Ocultar otro modal abierto, por si acaso
                    $('#Mantenimiento').modal('hide');

                    // Obtener el ID del ahorro desde la fila del botón
                    var idAhorro = $(this).closest('tr').find('.id_ahorro_valor').val();
                    $('#idAhorro').val(idAhorro);

                    // Si tienes un nombre de ahorro en la tabla
                    var ahorroDetalle = $(this).closest('tr').find('.nombre_ahorro').text();
                    $('#ahorroDetalle').text(ahorroDetalle || "(Sin nombre)");

                    // Limpiar estado anterior del formulario
                    $('#fechaInicio').val('');
                    $('#confirmMessage').hide();
                    $('#btnConfirmar').prop('disabled', true);

                    // Mostrar el modal de recalculo
                    $('#MantenimientoRecalculo').modal('show');
                });

                // Delegar también el evento del cambio de fecha (por si el modal se regenera)
                $(document).off('change', '#fechaInicio');
                $(document).on('change', '#fechaInicio', function () {
                    var fechaSeleccionada = $(this).val();

                    if (fechaSeleccionada) {
                        $('#confirmMessage').show();
                        $('#btnConfirmar').prop('disabled', false);
                    } else {
                        $('#confirmMessage').hide();
                        $('#btnConfirmar').prop('disabled', true);
                    }
                });
            }
            function Procesar_Recalculo() {
                $("#btnConfirmar").click(function () {
                    var idAhorro = $("#idAhorro").val();
                    var fechaInicio = $("#fechaInicio").val();

                    if (!fechaInicio) {
                        alertify.warning("Por favor ingresa una fecha válida.");
                        return;
                    }

                    // Enviar parámetros simples
                    $.post("@Url.Action("ProcesarRecalculo", "Ahorro")", {
                        idAhorro: idAhorro,
                        fechaInicio: fechaInicio
                    })
                        .done(function (response) {
                            alertify.success("Recalculo completado correctamente");
                            $("#MantenimientoRecalculo").modal("hide");
                            console.log(response);
                        })
                        .fail(function (xhr) {
                            alertify.error("Error al realizar el recalculo: " + xhr.responseText);
                            console.log(xhr);
                        });
                });
            }
            function EstadoCuenta() {

                $(document).off('click', '.ver_estado_cuenta');

                $(document).on('click', '.ver_estado_cuenta', function (e) {
                    e.preventDefault();
                    var fila = $(this).closest('tr');
                    var idAhorro = $(this).closest('tr').find('.id_ahorro_valor').val();

                    // opcional: agarrar número de cuenta desde columna
                   var idAhorro = fila.find('.id_ahorro_valor').val();
                    var noCuenta = fila.find('.no_cuenta').val();

                    $("#estadoCuentaIdAhorro").val(idAhorro);
                     $("#estadoCuentaDetalle").text(
                            noCuenta
                        );

                    $("#fechaInicioEC").val('');
                    $("#fechaFinEC").val('');

                    $("#MantenimientoEstadoCuenta").modal("show");
                });
            }
           $("#btnGenerarPDF").off("click").on("click", async function () {

            var id = $("#estadoCuentaIdAhorro").val();
            var inicio = $("#fechaInicioEC").val();
            var fin = $("#fechaFinEC").val();

            var texto = $("#textoPublicidad").val();

            var fileArriba = $("#imagenArribaFile")[0].files[0];
            var fileAbajo = $("#imagenAbajoFile")[0].files[0];

            if (!inicio || !fin) {
                alertify.warning("Selecciona ambas fechas");
                return;
            }

            let imgArriba = "";
            let imgAbajo = "";

            if (fileArriba) {
                imgArriba = await convertirBase64(fileArriba);
            }

            if (fileAbajo) {
                imgAbajo = await convertirBase64(fileAbajo);
            }

            $.ajax({
                url: '@Url.Action("GenerarEstadoCuentaPDF", "Ahorro")',
                type: "POST",
                data: {
                    idAhorro: id,
                    fechaInicio: inicio,
                    fechaFin: fin,
                    textoPublicidad: texto,
                    imagenArriba: imgArriba,
                    imagenAbajo: imgAbajo
                },
                xhrFields: {
                    responseType: 'blob' // 🔥 IMPORTANTE
                },
                success: function (data) {

                    var blob = new Blob([data], { type: 'application/pdf' });
                    var url = window.URL.createObjectURL(blob);

                    // abrir en nueva pestaña
                    window.open(url);

                    // opcional: descarga automática
                    // var a = document.createElement("a");
                    // a.href = url;
                    // a.download = "EstadoCuenta.pdf";
                    // a.click();
                },
                error: function () {
                    alertify.error("Error al generar PDF");
                }
            });

        });
            $("#btnEnviarCorreo").off("click").on("click", async function () {

                var id = $("#estadoCuentaIdAhorro").val();
                var inicio = $("#fechaInicioEC").val();
                var fin = $("#fechaFinEC").val();

                var texto = $("#textoPublicidad").val();

                var fileArriba = $("#imagenArribaFile")[0].files[0];
                var fileAbajo = $("#imagenAbajoFile")[0].files[0];

                if (!inicio || !fin) {
                    alertify.warning("Selecciona ambas fechas");
                    return;
                }

                let imgArriba = "";
                let imgAbajo = "";

                if (fileArriba) {
                    imgArriba = await convertirBase64(fileArriba);
                }

                if (fileAbajo) {
                    imgAbajo = await convertirBase64(fileAbajo);
                }

                $.ajax({
                    url: '@Url.Action("EnviarEstadoCuentaEmail", "Ahorro")',
                    type: "POST",
                    data: {
                        idAhorro: id,
                        fechaInicio: inicio,
                        fechaFin: fin,
                        textoPublicidad: texto,
                        imagenArriba: imgArriba,
                        imagenAbajo: imgAbajo
                    },
                    success: function () {
                        alertify.success("Correo enviado correctamente");
                    },
                    error: function () {
                        alertify.error("Error al enviar correo");
                    }
                });

            });
            function convertirBase64(file) {
                return new Promise((resolve, reject) => {
                    var reader = new FileReader();
                    reader.readAsDataURL(file);
                    reader.onload = () => resolve(reader.result);
                    reader.onerror = error => reject(error);
                });
            }
            function Editar_Ahorro() {
                $("#Editar_Ahorro_Cuenta").click(function() {
                    var cuenta_ahorro = $("#form_ahorro").serializeAnything();
                    $.post("@Url.Action("Editar_Ahorro_Manual", "Ahorro")",
                            cuenta_ahorro,
                            function (correcto) {
                                alertify.success("Editado  Exitosamente");
                                Detectar_Grid_Credito();
                            }).fail(function (error) {
                            alertify.error(error.responseText);
                            console.log(error);
                        });
                });
            }

            function Guardar_Ahorro() {
                $("#Guardar_Ahorro_Cuenta").click(function() {
                    var cuenta_ahorro = $("#form_ahorro").serializeAnything();
                    $.post("@Url.Action("Guardar", "Ahorro")",
                            cuenta_ahorro,
                            function (correcto) {
                                alertify.success(correcto);
                                Detectar_Grid_Credito();
                            }).fail(function (error) {
                            alertify.error(error.responseText);
                            console.log(error);
                        });
                });
            }
            function Guardar_Libreta() {
                $("#Guardar_Libreta").click(function () {
                    var id_ahorro = $(".id_ahorro_valor").val();
                    var No_Libreta = $("#valorLibreta").val();
                    var Activo = Boolean(true);

                    $.post("@Url.Action("Nueva_Libreta","Ahorro")",{
                            Id_Ahorro: id_ahorro, No_Libreta : No_Libreta, Activo:Activo},
                        function (correcto) {
                            alertify.success(correcto);
                            Detectar_Grid_Credito();
                        }).fail(function (error) {
                        alertify.error(error.responseText);
                        console.log(error);
                    });
                });
            }

            function Rotulado(id_ahorro) {
                $("input.N_Cuenta").each(function (index) {
                    $("input.N_Cuenta").eq(index).click(function () {
                        window.open("@Url.Action("Rotulado_Libreta", "Ahorro")?id_ahorro="+ id_ahorro);
                    });
                });

            }
              function N_Cuenta_Ahorro(id_ahorro) {
                  $("input.N_Libreta").each(function (index) {
                      $("input.N_Libreta").eq(index).click(function () {
                        window.open("@Url.Action("Cuenta_Ahorro_Libreta", "Ahorro")?id_ahorro="+ id_ahorro);
                    });
                });

            }
            function Ver_NCuenta() {
                var id_ahorro = $("input.id_ahorro_valor").val();
                $.get("@Url.Action("LibretaCliente", "Ahorro")",
                    { id_ahorro: id_ahorro },
                    function (cuenta) {
                        $("#NCuenta").html(cuenta.no_Libreta);
                        console.log(cuenta);
                    });
            }
            function Detectar_Grid_Credito() {
                $("#Mantenimiento").modal("hide");
                if ($("#ListaAhorros").length > 0) {
                    $("#ListaAhorros").dxDataGrid("instance").refresh();//probando si funciona
                } else {
                    //Cargar_Cuentas_Credito();
                }
            }

            function lookup_displayExpr(item) {
                if (!item) {
                    return "";
                }
                return item.Nombres + " " + item.Apellidos + " " + item.Dui;
            }

            function ObtenerPersona(item) {
                var id_persona = item.selectedItem.Id_Persona
                $("#id_persona").val(id_persona);
            }

            function RetornarPersona(rowData) {
                return rowData.Id_Persona = @Model.id_persona;
            }

            function Modificar_Columna(e) {
                if (e.rowType === "data" && e.column.command === "edit") {
                    $editLink = e.cellElement.find(".dx-link:contains(Edit)");
                    $editLink.text("Detalle");
                }
            }

            //manejo de Firma
            function Lista_Firmas_Autorizadas() {
                var id_ahorro = $("#form_ahorro #Id_Ahorro").val();
                $.get("@Url.Action("Firmas_Autorizada","Ahorro")",
                    { id_ahorro:id_ahorro },
                    function (lista) {
                        $("#lista_firma_autorizadas").html(lista);
                    });
            }

            function Nueva_Firma_Autorizada() {
                $(".nueva_firma_autorizada").click(function () {
                    var id_ahorro = $("#form_ahorro #Id_Ahorro").val();
                    Detalle_Firma_Autorizada(true,id_ahorro);
                });
            }

            function Detalle_Firma_Autorizada(esNuevo,id_ahorro) {
                $.get("@Url.Action("Detalle_Firma_Autorizada","Ahorro")",
                    { esNuevo: esNuevo, id_ahorro: id_ahorro },
                    function (form) {
                        $("div.Cargar_Mantenimiento_Adicional").html(form);
                        Guardar_Firma_Autorizada();
                    });
            }

            function Guardar_Firma_Autorizada() {
                $("#guardar_firma_autorizacion").click(function () {
                    var firma = $("#Nueva_Firma_Autorizada").serializeAnything();
                    $.post("@Url.Action("Nueva_Firma_Autorizada", "Ahorro")", firma, function (resultado) {
                        alertify.success(resultado);
                        Lista_Firmas_Autorizadas();
                    }).fail(function (error) {
                        alertify.error(error.responseText);
                    });
                });
            }

            function Documentos_Legales() {
                $("a.ver_detalle_documentos").each(function (index) {
                    $("a.ver_detalle_documentos").eq(index).click(function () {
                        var id_ahorro = $("input.documento_id").eq(index).val();
                        $.get("@Url.Action("Documentos_Legales_Ahorro", "Documentos_Legales")",
                            {},
                            function(perfil) {
                                $("div.Cargar_Mantenimiento_Adicional").html(perfil);
                                Abrir_Documentos(id_ahorro);
                            });
                    });
                });
            }

            function Abrir_Documentos(id_ahorro) {
                $("a.doc_legal").each(function(index) {
                    $("a.doc_legal").eq(index).click(function() {
                        var id_doc = $("input.id").eq(index).val();
                        if (id_doc == 18) {
                            Solicitud_Socio_Admision();
                        } else if (id_doc == 19) {
                            Solicitud_Cambio_Beneficiario(id_ahorro);
                        }
                        else if (id_doc == 20) {
                            Perfil_Socio();
                        }
                        else if (id_doc == 21) {
                            Declaracion_Jurada();
                        }
                        else if (id_doc == 16) {
                            Contrato_Deposito(id_ahorro);
                        }
                        else if (id_doc == 17) {
                            Contrato_Deposito_Copia(id_ahorro);
                        }

                    });
                });
            }

            function Solicitud_Socio_Admision() {
                var id_persona = @Model.id_persona;
                window.open("@Url.Action("Generar_Solicitud_Socio", "Ahorro")?id_persona=" + id_persona);
            }

            function Solicitud_Cambio_Beneficiario(id_ahorro) {
                var id_persona = @Model.id_persona;
                window.open("@Url.Action("Solicitud_Cambio_Beneficiario","Ahorro")?id_persona=" + id_persona + "&id_ahorro=" + id_ahorro);

            }
            function Perfil_Socio() {
                var id_persona = @Model.id_persona;
                window.open("@Url.Action("Perfil_Socio", "Ahorro")?id_persona=" + id_persona);
            }
            function Declaracion_Jurada() {
                var id_persona = @Model.id_persona;
                window.open("@Url.Action("Declaracion_Jurada", "Ahorro")?id_persona=" + id_persona);
            }
            function Contrato_Deposito(id_ahorro) {
                var id_persona = @Model.id_persona;
                window.open("@Url.Action("Contrato_Deposito","Ahorro")?id_persona=" + id_persona + "&id_ahorro=" + id_ahorro);

            }
            function Contrato_Deposito_Copia(id_ahorro) {
                var id_persona = @Model.id_persona;
                window.open("@Url.Action("Contrato_Deposito_Copia","Ahorro")?id_persona=" + id_persona + "&id_ahorro=" + id_ahorro);

            }
        </script>
    </div>
</div>
