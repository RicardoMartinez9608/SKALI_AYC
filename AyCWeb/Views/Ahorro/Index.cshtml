@using DevExtreme.AspNet.Mvc
@model ModelNucleo.Model.ModelView.AhorroFiltro
@{
    ViewData["Title"] = "Ahorros";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">
        <div class="row">
            <div class="col-lg-6">
                <h4>Ahorro</h4>
            </div>
            <div class="col-lg-6 text-right">
                <a href="#Mantenimiento" data-toggle="modal" class="btn btn-default nuevo_ahorro">Nuevo ahorro</a>
