        @(Html.DevExtreme().DataGrid().ID("ListaAhorros")
                                        .ShowBorders(true)
                                        .DataSource(d => d.Mvc()
                                            .Controller("Ahorro")
                                            .Key("Id_Ahorro")
                                            .LoadAction("Ahorros")
                                            .LoadParams(new
                                            {
                                                id_persona = Model.id_persona,
                                                porCliente = Model.porCliente,
                                                inicio = Model.inicio,
                                                final = Model.final
                                            }))
                                        .Columns(columns =>
                                        {
                                            columns.Add().DataField("Id_Ahorro").DataType(GridColumnDataType.Number).VisibleIndex(1).Visible(false);
                                            columns.Add().DataField("Id_Persona").DataType(GridColumnDataType.Number).VisibleIndex(2).Visible(false);

                                            columns.Add().DataField("Id_Linea_Ahorro").DataType(GridColumnDataType.Number).VisibleIndex(3)
                                            .Lookup(l => l.DataSource(d => d.Mvc().Controller("Linea_Ahorro").LoadAction("Lineas_Ahorro").Key("Id_Linea_Ahorro"))
                                            .ValueExpr("Id_Linea_Ahorro").DisplayExpr("Descripcion"));

                                            columns.Add().DataField("No_Ahorro").DataType(GridColumnDataType.String).VisibleIndex(4);
                                            columns.Add().DataField("Fecha_Apertura").DataType(GridColumnDataType.Date).VisibleIndex(5);
                                            columns.Add().DataField("Fecha_Retiro").Caption("Vencimiento").DataType(GridColumnDataType.Date).VisibleIndex(6);
                                            columns.Add().DataField("Tasa_Interes").Caption("Interés %").DataType(GridColumnDataType.Number).VisibleIndex(7);
                                            columns.Add().DataField("Plazo").DataType(GridColumnDataType.Number).VisibleIndex(8);
                                            columns.Add().CellTemplate(@<text>
                                              <input type="hidden"  id="id_ahorro_doc" class="documento_id" value="<%=data.Id_Ahorro%>"/>
                                              <a href="#Mantenimiento_Adicional" data-toggle="modal" class="ver_detalle_documentos" >Documentos</a>
                                                                        </text>).Caption("No Acta").VisibleIndex(16).FormItem(f => f.Editor(w => w.NumberBox().Visible(false)).Label(l => l.Visible(false)));
                                            columns.Add().Fixed(true).VisibleIndex(9).CellTemplate(
                                                    @<text>
                                                        <input type="hidden" class="id_ahorro_valor" value="<%=data.Id_Ahorro%>" />
                                                        <a href="#Mantenimiento" data-backdrop="false" data-toggle="modal" class="btn btn-default ver_detalle">Detalle</a>
                                                     </text>

                                                );
                                            columns.Add().Fixed(true).VisibleIndex(10).CellTemplate(
                                                    @<text>
                                                    <input type="hidden" class="id_ahorro_valor" value="<%=data.Id_Ahorro%>" />
                                                    <a href="#MantenimientoRecalculo" data-backdrop="false" data-toggle="modal" class="btn btn-default ver_detallerecalculo ">Recalculo</a>
                                                </text>
                                                );
                                            columns.Add().Fixed(true).Width(170).VisibleIndex(11).CellTemplate(
                                                    @<text>
                                                    <input type="hidden" class="id_ahorro_valor" value="<%=data.Id_Ahorro%>" />
                                                       <input type="hidden" class="no_cuenta" value="<%=data.No_Ahorro%>" />
                                                    <a href="#" class="btn btn-default ver_estado_cuenta">Estado de Cuenta</a>
                                                </text>
                                                );

                                        }).OnCellPrepared("Modificar_Columna")
                                        .Paging(p => p.Enabled(true)).OnContentReady("DataGridPreparada")

                            .FilterRow(f => f.Visible(false))
                            .HeaderFilter(f => f.Visible(false))
                            .GroupPanel(p => p.Visible(false))
                            .Grouping(g => g.AutoExpandAll(true))
                            .RemoteOperations(true)
                            .MasterDetail(d =>
                            {
                                d.Enabled(true);
                                d.Template(@<text>
                                    <h4>Transacciones</h4>
                                    @(Html.DevExtreme().DataGrid().ID("Transacciones_Ahorro")
                                                .ColumnAutoWidth(true)
                                                .ShowBorders(true)
                                                .Columns(columns =>
                                                    {
                                                            columns.Add().DataField("Fecha");
                                                            columns.Add().DataField("Deposito").Caption("Depósito");
                                                            columns.Add().DataField("Retiro");
                                                            columns.Add().DataField("Saldo");
                                                        })
                                                .FilterRow(fi => fi.Visible(false))
                                                        .HeaderFilter(h => h.Visible(false))
                                                        .GroupPanel(p => p.Visible(false))
                                                        .Grouping(g => g.AutoExpandAll(true))
                                                        .RemoteOperations(true)
                                                        .DataSource(g => g.Mvc()
                                                                .Controller("Ahorro")
                                                                .LoadAction("Transacciones2").Key("Id")
                                                                .LoadParams(new { id_ahorro = new JS("data.Id_Ahorro") })
                                                            )
                                    )
                                </text>);
                                                    })
        )
