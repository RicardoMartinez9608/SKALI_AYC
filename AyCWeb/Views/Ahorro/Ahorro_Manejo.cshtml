            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Id_Linea_Ahorro" class="control-label">Linea de Ahorro</label>
                    @Html.DropDownList("Id_Linea_Ahorro", null, htmlAttributes: new { @class = "form-control" })
                    <span asp-validation-for="Id_Linea_Ahorro" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
