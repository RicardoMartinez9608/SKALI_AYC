@using DevExtreme.AspNet.Mvc
@model IEnumerable<ModelNucleo.Model.Linea_Ahorro>
@{
    ViewData["Title"] = "Líneas de ahorro";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">Líneas de ahorro</div>
    <div class="panel-body panel-body-personalizado">

        @(Html.DevExtreme().DataGrid().ID("ListaLineaAhorro")
            .ShowBorders(false)
            .DataSource(d => d.Mvc()
            .Controller("Linea_Ahorro")
            .Key("Id_Linea_Ahorro")
            .LoadAction("Lineas_Ahorro")
            .UpdateAction("Edit")
            .InsertAction("Create")
            .DeleteAction("Delete"))
            .Columns(columns =>
            {
                columns.Add().DataField("Id_Linea_Ahorro").DataType(GridColumnDataType.Number).VisibleIndex(0).FormItem(fi => fi.Editor(e => e.NumberBox().ID("Id_Linea_Ahorro")));
                columns.Add().DataField("Descripcion").DataType(GridColumnDataType.String).VisibleIndex(2).FormItem(fi => fi.Editor(e => e.TextArea().ID("Descripcion")));
                columns.Add().DataField("Id_Tipo_Linea_Ahorro").DataType(GridColumnDataType.Number).VisibleIndex(3).Lookup(l => l.DataSource(d => d.Mvc().Controller("Linea_Ahorro").LoadAction("TipoLineaAhorro").Key("Id_Tipo_Linea_Ahorro"))
                    .ValueExpr("Id_Tipo_Linea_Ahorro").DisplayExpr("Descripcion")).FormItem(d => d.Editor(a => a.Lookup().ID("Id_Tipo_Linea_Ahorro")));
                columns.Add().DataField("Tasa_Interes").DataType(GridColumnDataType.Number).VisibleIndex(4).FormItem(fi => fi.Editor(e => e.NumberBox().ID("Tasa_Interes")));
                
            }).OnCellPrepared("Modificar_Columna")
            .Paging(p => p.Enabled(false))
            .Editing(e => e.Mode(GridEditMode.Popup)
                .AllowUpdating(true)
                .Popup(p => p.Title("Configuración de Líneas de ahorro").ID("editarLinea")
                .ToolbarItems(a => a.Add()
                    .Widget(c => c.Button().Type(ButtonType.Default).Text("Guardar").OnClick("GuardaryCerrar")).Location(ToolbarItemLocation.After).Toolbar(Toolbar.Bottom))
                    .ShowTitle(true)
                    .Width(780)
                    .Height(400)
                    .Position(pos => pos
                        .My(HorizontalAlignment.Center, VerticalAlignment.Top)
                        .At(HorizontalAlignment.Center, VerticalAlignment.Top)
                        .Of(new JS("window")))
                    ).AllowAdding(true))
            .FilterRow(f => f.Visible(false))
            .HeaderFilter(f => f.Visible(false))
            .GroupPanel(p => p.Visible(false))
            .Grouping(g => g.AutoExpandAll(true))
            .RemoteOperations(true))
    </div>
    <script>
        function GuardaryCerrar(e) {
            var grid = $("#ListaLineaAhorro").dxDataGrid("instance");
            grid.saveEditData();
        }
        function Modificar_Columna(e) {
            if (e.rowType === "data" && e.column.command === "edit") {
                $editLink = e.cellElement.find(".dx-link:contains(Edit)");
                $editLink.text("Detalle");
            }
        }
    </script>
</div>