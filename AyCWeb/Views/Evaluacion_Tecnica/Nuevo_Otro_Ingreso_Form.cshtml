@model ModelNucleo.Model.Evaluacion_Tecnica.Otro_Ingreso
@{
    ViewData["Title"] = "Nuevo Otro Ingreso_Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<br />
<br />
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">Nuevo Otro Ingreso</div>
    <div class="panel-body">
        <form asp-action="Nuevo_Otro_Ingreso">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id_Otro_Ingreso" type="hidden" class="form-control" />
            <input asp-for="Id_Evaluacion" value="@ViewBag.Id_Evaluacion" type="hidden" class="form-control" />


            <div class="form-group">
                <label asp-for="Id_Tipo_Ingreso" class="control-label">Tipo Ingreso</label>
                <select asp-for="Id_Tipo_Ingreso" asp-items="@ViewBag.Id_Tipo_Ingreso" class="form-control"></select>
                <span asp-validation-for="Id_Tipo_Ingreso" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Valor" class="control-label">Valor</label>
                <input asp-for="Valor" class="form-control" />
                <span asp-validation-for="Valor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Frecuencia" class="control-label">Frecuencia</label>
                <input asp-for="Frecuencia" class="form-control" />
                <span asp-validation-for="Frecuencia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>