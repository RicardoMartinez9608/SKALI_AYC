@model ModelNucleo.Model.Evaluacion_Tecnica.Prestamo

@{
    ViewData["Title"] = "Modificar Préstamo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<br />
<br />
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">Modifcar Préstamo</div>
    <div class="panel-body">
        <form asp-action="Modificar_Prestamo">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id_Prestamo" type="hidden" class="form-control" />
            <input asp-for="Id_Evaluacion" type="hidden" class="form-control" />

            
            <div class="form-group">
                <label asp-for="Monto_Otorgado" class="control-label">Monto Otorgado</label>
                <input asp-for="Monto_Otorgado" class="form-control" />
                <span asp-validation-for="Monto_Otorgado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cuota" class="control-label">Cuota</label>
                <input asp-for="Cuota" class="form-control" />
                <span asp-validation-for="Cuota" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Frecuencia" class="control-label">Frecuencia</label>
                <input asp-for="Frecuencia" class="form-control" />
                <span asp-validation-for="Frecuencia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Saldo" class="control-label">Saldo</label>
                <input asp-for="Saldo" class="form-control" />
                <span asp-validation-for="Saldo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Total" class="control-label">Total</label>
                <input asp-for="Total" class="form-control" />
                <span asp-validation-for="Total" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

