<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AyCWeb</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.min.css" />
    <link href="~/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />
    <link href="~/css/alertify.min.css" rel="stylesheet" />
    @*<link href="~/css/bs.sm.min.css" rel="stylesheet" />*@

    <link href="~/css/hack_boot.min.css" rel="stylesheet" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/js/site.min.js"></script>
    <script src="~/lib/Serializer.js"></script>

    @*<script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?v=3.exp&sensor=false&key=AIzaSyAhsamxSee5wvM2zjRCc0l1TqViYahUA98"></script>*@

    <link href="~/css/leaflet.css" rel="stylesheet" />
    <script src="~/js/leaflet.js"></script>
    <script src="~/js/devextreme/cldr.js"></script>
    <script src="~/js/devextreme/cldr/event.js"></script>
    <script src="~/js/devextreme/cldr/supplemental.js"></script>
    <script src="~/js/devextreme/cldr/unresolved.js"></script>

    <script src="~/js/devextreme/globalize.js"></script>
    <script src="~/js/devextreme/globalize/message.js"></script>
    <script src="~/js/devextreme/globalize/number.js"></script>
    <script src="~/js/devextreme/globalize/currency.js"></script>
    <script src="~/js/devextreme/globalize/date.js"></script>
    <script src="~/js/alertify.min.js"></script>
    <script src="~/js/jquery.mask.min.js"></script>
    @*<script src="~/js/bs.sm.min.js"></script>*@

    @* JSZip for client side export *@
    @*<script src="~/js/devextreme/jszip.js"></script>*@

    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/vectormap-data/world.js"></script>
    <script src="~/lib/devextreme-aspnet-data/js/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
    @*<link href="~/css/bootstrap-switch.min.css" rel="stylesheet" />
        <script src="~/js/bootstrap-switch.min.js"></script>*@


    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</head>
<body>
    <nav class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header" style="height: 58px; align-content: center">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse" style="align-content: center">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="navbar-brand"><img id="logoEmpresa" /></a>

            </div>
            <div class="navbar-collapse collapse ">
                <ul class="nav navbar-nav menu_parcial">
                    
                </ul>
                <div class="manejoUsuario"></div>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p><span id="nombreEmpresa"></span> Skali @Microsoft.Extensions.PlatformAbstractions.PlatformServices.Default.Application.ApplicationVersion</p>
        </footer>
    </div>

@RenderSection("Scripts", required: false)
    <div class="modal" id="Logout"  data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog" style="width:750px">
            <div class="modal-content">
                <div class="modal-header">
                    
                    <h3 class="alert alert-warning" id="titulo_sub_modal">Cierre de Sesión</h3>
                </div>
                <div class="modal-body Cargar_Mantenimiento_Adicional">
                    <h5 class="alert alert-warning" id="titulo_sub_modal"><span class="glyphicon glyphicon-warning-sign"></span><strong> Alerta!</strong> La Sesión ha caducado, ingresa de nuevo</h5>
                   
                </div>
                <div class="modal-body Cargar_Mantenimiento_Adicional">
                    <button class="btn btn-warning" type="button"  data-toggle="collapse" data-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample" onclick="location.href = '@Url.Action("Login", "Home")'">
                        Iniciar Sesion
                    </button>
                </div>
            </div>
        </div>
    </div>
    <link href="~/css/ventanas.css" rel="stylesheet" />

    <script>
        $(function () {
            //setInterval("VerificarSesionViva()", 3000000);
            NombreUsuario();
            NombreEmpresa();
            LogoEmpresa();
            VerificarSesionViva();
            Parcial();
        });

        function VerificarSesionViva() {
            $(".nav a").click(function() {
                $.get("@Url.Action("VerificarSession", "Home")", function (respuesta) {
                    if (respuesta == "0") {
                        console.log("probando");
                        ModalLogout();
                    }
                });
            });
        }
        function Parcial() {
            $.get("@Url.Action("Menu","Home")", function (html) { $(".menu_parcial").html(html); });
        }
        function NombreUsuario() {
            $.get("@Url.Action("ManejoUsuario","Home")", function (html) { $(".manejoUsuario").html(html); });
        }

        function NombreEmpresa() {
            $.get("@Url.Action("VerificarNombreEmpresa", "Home")", function  (respuesta) {
                $("#nombreEmpresa").text(respuesta.replace(/['"]+/g, ''));
            });
        }
        function LogoEmpresa() {
            $.get("@Url.Action("LogoLayout", "Home")", function  (respuesta) {
                $("#logoEmpresa").attr('src','data:image/png;base64,'+ respuesta.replace(/['"]+/g, ''));
            });
        }
        function ModalLogout () {
            $("#Logout").modal('show');
            $("#Logout").modal({backdrop: 'static', keyboard: false});

        }
        $(document).on('show.bs.modal', '.modal', function (event) {
            var zIndex = 1040 + (10 * $('.modal:visible').length);
            $(this).css('z-index', zIndex);
            setTimeout(function () {
                $('.modal-backdrop').not('.modal-stack').css('z-index', zIndex - 1).addClass('modal-stack');
            }, 0);
        });
    </script>
</body>


</html>
