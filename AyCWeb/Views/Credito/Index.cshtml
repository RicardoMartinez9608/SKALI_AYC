        function Modificar_Refinanciamiento() {
            $("#Modificar_Value").click(function() {
                var movible = true;
                var monto_nuevo = $("#nuevo_valor_refil").val();
                Detalle_Refinanciable_Valor_Nuevo(movible,monto_nuevo,false);
            });
            }
            function Modificar_Reestructura() {
                $("#Modificar_Value").click(function () {
                    var movible = true;
                    var monto_nuevo = $("#nuevo_valor_refil").val();
                    Detalle_Refinanciable_Valor_Nuevo(movible, monto_nuevo,true);
                });
            }
            function Detalle_Refinanciable_Valor_Nuevo(movible, monto_nuevo_refinanciamiento, es_reeestructura = false) {
                var codigo_credito = $("#codigo_credito_refinanciable").val();
                var id_credito = $("#form_credito #Id_Credito").val();
                if (es_reeestructura) {
                    $.get("@Url.Action("Reestructura", "Credito")",
                    {
                        id_credito: id_credito,
                        codigo_credito: codigo_credito,
                        movible: true,
                        monto_nuevo_reestructura: monto_nuevo_refinanciamiento
                    },
                        function (detalle) {
                        $("#detallle_reestructura").html(detalle);
                        Cargar_Cambiar_Valor_Reestructura();
                        var value = $("#valor_actual_reestructura").val();
                        Cargar_Detalle_Cambio_Valor(value,true)
                        Guardar_Reestructura();
                        $('#Modal_Cambio_Valor_Reestructura').modal('hide');
                    });
                }
                else {
                     $.get("@Url.Action("Refinanciable", "Credito")",
                    {
                        id_credito: id_credito,
                        codigo_credito: codigo_credito,
                        movible: movible,
                        monto_nuevo_refinanciamiento : monto_nuevo_refinanciamiento
                    },
                    function (detalle) {
                       
                            $("#detallle_refinanciable").html(detalle);
                            Cargar_Cambiar_Valor();
                            var value = $("#valor_actual").val();
                            Cargar_Detalle_Cambio_Valor(value);
                            Guardar_Refinaciable();
                            $('#Modal_Cambio_Valor').modal('hide');
                    });
                }

        }

        function Cargar_Detalle_Cambio_Valor(value,es_reeestructura = false) {
            $.get("@Url.Action("Cambiar_Valor_Refinanciamiento", "Credito")",
                function (busqueda) {
                    if (es_reeestructura) {
                        $("div.detalle_cambio_valor_reestructura").html(busqueda);
                        $("#valor_Actual_Refil").text(value);
                        Modificar_Reestructura();
                    } else {
                        $("div.detalle_cambio_valor_refil").html(busqueda);
                        $("#valor_Actual_Refil").text(value);
                        Modificar_Refinanciamiento();
                    }


                });
        }

