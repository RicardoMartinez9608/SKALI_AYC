            function Abrir_Documentos(id_credito) {
            $("a.doc_legal").each(function (index) {
                $("a.doc_legal").eq(index).click(function () {

                    var id_doc = $("input.id").eq(index).val();
                    if (id_doc == 1) {
                        Mostrar();
                    }
                    else if (id_doc == 2) {
                        Mutuo(id_credito);
                    }
                    else if (id_doc == 3) {
                        Pagare(id_credito);
                    }
                    else if (id_doc == 22) {
                        PagareC(id_credito);
                    }
                    else if (id_doc == 4) {
                        Condiciones_Generales(id_credito);
                    } else if (id_doc == 7) {
                        Mutuo_Copia();
                    }
                    else if (id_doc == 11) {
                        Carta_Azul(id_credito);
                    } else if (id_doc == 12) {
                        PlanAyC(id_credito);
                    }
                    else if (id_doc == 15) {
                            Compartir_DatosFiador(id_credito);
                    }
                    else if (id_doc == 14) {
                        Pantalla(id_credito);
                    } else if (id_doc == 13) {
                        Compartir_Datos(id_credito);
                    }else if (id_doc == 9) {
                            OrdenDescuendoD(id_credito);
                    }else if (id_doc == 10) {
                            OrdenDescuendoF(id_credito);
                    }else if (id_doc == 8) {
                            Calendario(id_credito);
                    }
                });
            });
            }

