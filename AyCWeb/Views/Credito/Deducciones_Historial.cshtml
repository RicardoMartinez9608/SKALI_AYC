@model IEnumerable<ModelNucleo.Model.Deduccion_Historial>

<table class="table">
    <thead>
        <tr>
            <th>
                Código Crédito
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Valor)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr class="deduccion_fila">
            <td>
                @item.Linea_Credito_Historial.Credito.Codigo_Credito
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @item.Valor.ToString("C")
            </td>
            <td>
                <input type="hidden" class="id_deduccion_historial_valor" value="@item.Id_Deduccion_Historial" />
                <a href="#modal_detalle_deduccion" class="Cobrar_Deduccion" data-backdrop="false" data-toggle="modal">Cobrar deducción</a>
            </td>
        </tr>
}
    </tbody>
</table>
