</div>
<div id="Detalle_Refinanciable">
    <input type="hidden" asp-for="Id_Credito_Refinanciable" /> 
    <input type="hidden" asp-for="Codigo_Refinanciable" />
    <input type="hidden" asp-for="Socio_Refinanciado" />
    <input type="hidden" asp-for="Dui_Socio_Refinanciado" />
    <input type="hidden" asp-for="Id_Credito_Nuevo" />
    <input type="hidden" asp-for="Monto_Refinanciable" />
    <input type="hidden" asp-for="Monto_Nuevo" />
    <input type="hidden" asp-for="Remanente" />
</div>
<a href="#" class="btn btn-default" id="procesar_refinanciado">Refinanciar</a>
