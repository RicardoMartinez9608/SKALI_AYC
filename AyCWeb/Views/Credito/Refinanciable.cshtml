@model ModelNucleo.Model.ModelView.Refinanciable

<div >
    <h4>Refinanciable</h4>
    <hr />
    <table>
      
        <tbody>
        <tr>
            <td>
                Código Crédito
            </td>
            <th>
                @Html.DisplayFor(model => model.Codigo_Refinanciable)
            </th>
        </tr>
        <tr>
            <td>
                Socio 
            </td>
            <th>
                @Html.DisplayFor(model => model.Socio_Refinanciado)
            </th>
        </tr>
        <tr>
            <td>
                Dui del socio 
            </td>
            <th>
                @Html.DisplayFor(model => model.Dui_Socio_Refinanciado)
            </th>
        </tr>
        <tr>
            <td>
                Monto a pagar para cancelar el crédito
            </td>
            <th>
                <input type="hidden" value="@Model.Monto_Refinanciable.ToString("#.##")" id="valor_actual" />
                @Html.DisplayFor(model => model.Monto_Refinanciable)
            </th>
            <th>
                <input type="button" value="Cambiar Monto de Refinanciamiento" id="cambiar_valor" class="btn btn-primary" />
            </th>
        </tr>
        <tr>
            <td>
                Monto del nuevo crédito
            </td>
            <th>
                @Html.DisplayFor(model => model.Monto_Nuevo)
            </th>
        </tr>
        <tr>
            <td>
                Remanente después de la refinanciación
            </td>
            <th>
                @Html.DisplayFor(model => model.Remanente)
            </th>
        </tr>
        <tr>
            <td>
                Es refinanciable
            </td>
            <th>
                @Html.DisplayFor(model => model.EsRefinanciable)
            </th>
        </tr>
        </tbody>
    </table>
