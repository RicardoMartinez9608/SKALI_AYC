
<div class="row">

    <div class="col-md-8">
        <div class="form-group">
            <strong>Valor Actual del Refinanciamiento </strong> <span id="valor_Actual_Refil"></span>
        </div>
    </div>
   
</div>
<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <input type="radio" name="disminuir" id="disminuir" value="true" checked />
            <label for="disminuir" class="control-label">Disminuir</label>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <input type="radio" name="disminuir" id="aumentar" value="false" />
            <label for="aumentar" class="control-label">Aumentar</label>
        </div>
    </div>
                
</div>

<div class="row">
    <div class="col-md-8">
        <div class="form-group">
            <input class="form-control" id="nuevo_valor_refil" type="number" placeholder="Ingrese el nuevo monto de Refinanciamiento" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <input type="button" value="Modificar" id="Modificar_Value" class="btn btn-primary" />
        </div>
    </div>
</div>