@model ModelNucleo.Model.ModelView.Credito_Amortizacion
@{
    ViewData["Title"] = "Detalle del crédito y Amortización";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">Detalle del crédito y Amortización, cliente: @Model.Cliente.Nombres @Model.Cliente.Apellidos</div>
    <div class="panel-body panel-body-personalizado">
        <div class="bs-example bs-example-tabs" data-example-id="togglable-tabs">
            <ul id="myTabs" class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#amortizacion" id="amortizacion-tab" role="tab" data-toggle="tab" aria-controls="amortizacion" aria-expanded="true">Amortización</a></li>
                <li role="presentation"><a href="#cliente" role="tab" id="cliente-tab" data-toggle="tab" aria-controls="cliente">Cliente</a></li>
                <li role="presentation"><a href="#credito" role="tab" id="credito-tab" data-toggle="tab" aria-controls="credito">Crédito</a></li>
            </ul>

            <div id="myTabContent" class="tab-content">
                <div role="tabpanel" class="tab-pane fade in active" id="amortizacion" aria-labelledBy="amortizacion-tab">

                    <table class="table">
                        <thead>
                            <tr>
                                <th>
                                    No
                                </th>
                                <th>
                                    Fecha pago
                                </th>
                                <th>
                                    Dias
                                </th>
                                <th>
                                    Interés
                                </th>
                                <th>
                                    Plan AyC
                                </th>
                                <th>
                                    IVA AyC
                                </th>
                                <th>
                                    Otros Cobros
                                </th>
                                <th>
                                    Abono Capital
                                </th>
                                <th>
                                    Valor Cuota
                                </th>
                                <th>
                                    Saldo Capital
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Amortizacion)
                    {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.No)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.FechaPago)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Dias)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Interes)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Comision)
                                </td>
                                <td>
                                    @*@Html.DisplayFor(modelItem => item.IvaSobreComision)*@
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Otros_Cobros)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Abono_capital)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Valor_Cuota)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Saldo_Capital)
                                </td>

                            </tr>
            }
                        </tbody>
                    </table>
                    <form action="@Url.Action("Amortizacion", "Reporteria")" method="get" target="_blank">
                        <input type="hidden" name="id_linea" value="@Model.Credito.Id_Linea" />
                        <input type="hidden" name="monto" value="@Model.Credito.Monto_pago" />
                        <input type="hidden" name="id_periodo" value="@Model.Credito.Periodo.Id_Periodo" />
                        <input type="hidden" name="plazo" value="@Model.Credito.Plazo" />
                        <input type="hidden" name="id_credito" value="@Model.Credito.Id_Credito" />
                        <input type="hidden" name="numero_cuotas" value="@Model.Credito.Numero_cuotas" />
                        <input type="submit" value="Exportar" id="Exportar" />
                    </form>

                    
                    <script>
                        $(function () {
                            $("#Exportar").click(function () {
                                $("input[name='GridHtml']").val($("#amortizacion").html());
                            });
                        });
                        
                    </script>
                </div>

                <div role="tabpanel" class="tab-pane fade" id="cliente" aria-labelledBy="cliente-tab">
                    <dl class="dl-horizontal">
                        <dt>
                            @Html.DisplayNameFor(model => model.Cliente.Nombres)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.Cliente.Nombres)
                        </dd>
                        <dt>
                            @Html.DisplayNameFor(model => model.Cliente.Apellidos)
                        </dt>
                        <dd>
