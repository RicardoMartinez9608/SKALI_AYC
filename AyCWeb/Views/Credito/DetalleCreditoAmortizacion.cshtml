                        </dd>
                        <dt>
                            @Html.DisplayNameFor(model => model.Cliente.ExpedicionDocumentoIdentifcacion)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.Cliente.ExpedicionDocumentoIdentifcacion)
                        </dd>
                        <dt>
                            @Html.DisplayNameFor(model => model.Cliente.ExpiracionDocumentoIdentificacion)
