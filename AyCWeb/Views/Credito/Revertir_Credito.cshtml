@model ModelNucleo.Model.ModelView.Reversion_Credito

@{
    ViewData["Title"] = "Revertir_Credito";
    Layout = "";
}
<div style="font-size: 24px">
    <h4 align="center">SOCIEDAD COOPERATIVA CREDITOS A&C DE R.L.</h4>
  
    <h4 align="center">COMPROBANTE DE REVERSIÓN DE LIQUIDACIÓN</h4>
    <table align="left">
        <tbody>
        <tr>
            <td>
                Fecha de Impresión  @Model.Emision
            </td>

            <td style="width: 150px">
            </td>
            <td>
                @Model.Usuario
            </td>
            <td style="width: 150px">
            </td>
        </tr>
        </tbody>
    </table>
    <br />
    <h4 align="center">DETALLE DE LA REVERSIÓN </h4>
    <br />
    <table align="center">
        <tbody>
        <tr>
            <td>
                NUMERO DE LA CUENTA:  @Model.Codigo_Credito
            </td>

        </tr>
        <tr>
            <td>
                NOMBRE DE LA CUENTA: @Model.Cliente
            </td>
        </tr>
        <tr style="width: 100px">
            <td>
                VALOR DE LA REVERSIÓN: @Model.Monto.ToString("#.##")
            </td>
        </tr>
        <tr>
            <td style="width: 320px">
                FECHA DE REVERSIÓN: @Model.Revertido_En
            </td>
        </tr>
        <tr>
            <td style="width: 350px">
                FECHA DE APERTURA: @Model.Aperturado_En
            </td>
        </tr>
        <tr>
            <td style="width: 150px">
                CONCEPTO: REVERSIÓN DE LIQUIDACIÓN 
            </td>
        </tr>
        <tr>
            <td style="width: 500px">
                REVERTIDO POR: USUARIO: @Model.Usuario
            </td>
            
        </tr>
        </tbody>
    </table>
    <table align="center">
        <tr>
            <td>_______________________________________</td>
            <td>_______________________________________</td>
            
        </tr>
        <tr align="center">
            <td>ELABORADO</td>
            <td>AUTORIZADO</td>
        </tr>
    </table>
