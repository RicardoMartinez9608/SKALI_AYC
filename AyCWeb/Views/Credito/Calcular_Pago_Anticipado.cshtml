@{
    ViewData["Title"] = "Calcular Pago Anticipado";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string baseUrl = Html.ViewContext.HttpContext.Request.PathBase.Value.ToString();
}
<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">Cálcular Pago Anticipado</div>
    <div class="panel-body panel-body-personalizado">
        <div id="mensajes"></div>
        <p></p>
        <div class="row">
            <div class="col-lg-4">
                <div class="input-group">
                    <input type="text" name="dui_buscar" id="dui_buscar" placeholder="introduzca un DUI/Código válido completo" class="form-control" />
                    <span class="input-group-btn">
                        <button class="btn btn-default" type="button" id="buscarpordui">Buscar</button>
                    </span>
                </div>
            </div>
        </div>

        <p></p>
        <div class="panel panel-default">
            <div class="panel-body">
                <table>
                    <tr>
                        <th>Nombre completo: </th>
                        <td><span class="nombre_completo"></span></td>
                    </tr>
                    <tr>
                        <th>DUI: </th>
                        <td><span class="dui"></span></td>
                    </tr>
                    <tr>

                    </tr>
                </table>
            </div>
        </div>
        <p></p>

        <div class="well">
            <div class="btn-group btn-group-lg" role="group" aria-label="...">
                <div class="creditos btn-group" role="group">
                  
                </div>
              
                <div class="btn-group" role="group">
                    <button class="btn btn-default calcular_pago" type="button">Obtener Información</button>
                </div>
            </div>
           
        </div>
        <div class="row" style="align-content:center">
     
         
    </div>
    </div>
   
     
</div>
<div class="modal fade" id="Modal_Calculo_Anticipado" style="align-content: center">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Información para Pago Anticipado</h4>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="form-group">
                        
                         <div class="detalle_anticipado">  </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
               
                <button type="button" id="calcular" class="btn btn-primary">Calcular</button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/manejo/manejo_caja.js"></script>
