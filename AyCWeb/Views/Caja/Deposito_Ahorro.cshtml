@{
    ViewData["Title"] = "Pago Cuenta de Ahorro";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string baseUrl = Html.ViewContext.HttpContext.Request.PathBase.Value.ToString();
}
<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">Depósito Cuenta de Ahorro</div>
    <div class="panel-body panel-body-personalizado">
        <div id="mensajes"></div>
        <p></p>

        <div class="row">
            <div class="col-lg-4">
                <div class="input-group">
                    <input type="text" name="dui_buscar" id="dui_buscar" placeholder="introduzca un DUI/Código válido completo" class="form-control" />
                    <span class="input-group-btn">
                        <button class="btn btn-default" type="button" id="buscarpordui">Buscar</button>
                    </span>
                </div>
            </div>
        </div>
        <p></p>
        <div class="panel panel-default">
            <div class="panel-body">
                <table>
                    <tr>
                        <th>Nombre completo: </th>
                        <td><span class="nombre_completo"></span></td>
                    </tr>
                    <tr>
                        <th>DUI: </th>
                        <td><span class="dui"></span></td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-body">

                <div class="checkbox">
                    <label>
                        <input type="checkbox" name="cambiar_fecha" id="cambiar_fecha"> Cambiar Fecha
                    </label>
                </div>

                <div class="form-group">
                    <label for="fecha_cambiada" class="control-label">Nueva fecha</label>
                    <input type="date" id="fecha_cambiada" class="form-control limpiar" />
                </div>
            </div>
        </div>

        <p></p>
        <div style="min-height:400px">

            <div id="cuentasContenido" class="tab-content">
                <div role="tabpanel" class="tab-pane fade in active" id="ahorro" aria-labelledby="ahorro-tab">

                    <p></p>
                    <div class="well">

                        <div class="btn-group btn-group-lg" role="group" aria-label="...">
                            <div class="btn-group ahorros" role="group">
                            </div>
                            <div class="btn-group " role="group">
                                <input type="text" min="0" id="valor" placeholder="Monto Transacción" class="form-control limpiar solo-numero" />
                            </div>
                            <div class="btn-group" role="group">
                                <a href="#Modal_Para_Ahorros" data-toggle="modal" class="btn btn-default" id="deposito">Aplicar Depósito</a>
                            </div>

                            <div class="btn-group" role="group">
                                <span id="ncomprobante" style="display: none"></span>
                            </div>

                        </div>
                        @Html.Partial("_Herramienta_Caja_Transaccion")
                    </div>
                    <p></p>
                    <div class="transacciones" style=" height:300px;"></div>
                </div>
                <div role="tabpanel" class="tab-pane" id="credito" aria-labelledby="credito-tab">

                    <div class="well">
                        <div class="btn-group btn-group-lg" role="group" aria-label="...">
                            <div class="creditos btn-group" role="group">

                            </div>
                            <div class="btn-group" role="group">
                                <button class="btn btn-default abono" type="button">Registrar Abono</button>
                            </div>
                        </div>
                        @Html.Partial("_Herramienta_Caja_Transaccion")
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ahorros-->
<div class="modal fade" id="Modal_Para_Ahorros" style="align-content: center">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Ingrese el No. de Comprobante</h4>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Ingrese el número de comprobante para realizar un Depósito</label>
                        <label class="control-label">No Comprobante</label>
                        <input class="form-control cdeposito" id="numero_comprobante_ahorro" type="number" />

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                <button type="button" id="siguiente_comprobante_ahorro" class="btn btn-primary">Continuar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Libreta-->
<div class="modal fade" id="Modal_Libreta" style="align-content: center">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Ingrese los siguientes datos para continuar</h4>
            </div>
            <div class="row">

            </div>
            <div class="modal-body">
                <div class="col-md-8">
                    <div class="form-group">
                        <label>Ingrese el número de renglón</label>
                        <input class="form-control cretiro" id="numero_renglon" type="number" />
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                <button type="button" id="siguiente_libreta" class="btn btn-primary">Continuar</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/manejo/manejo_caja.js"></script>

<script>
    //buscando el una persona valida
    $(function () {
        constructor("@baseUrl");
        $("#dui_buscar").mask("00000000-0");
        //BuscarPorDui();
    });

    $(document).ready(function () {
        BotonesAsesores(); 
        $('.solo-numero').keyup(function () {

            var exp = /^[+]?([0-9]+(?:[\.][0-9]*)?|\.[0-9]+)$/;
            if(!exp.test(this.value))
                this.value ="";
        });
    });
    function BotonesAsesores() {
        var rol_quote = "@ViewBag.Rol";
        var rol = rol_quote.replace(/(&quot\;)/g, "\"", /['"]+/g);
        if (rol !== "Administrador" && rol !== "Jefe" && rol  ) {
            $('.revertir').hide();
        }
    }
</script>
