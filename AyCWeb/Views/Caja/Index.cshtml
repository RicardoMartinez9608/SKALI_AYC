@using DevExtreme.AspNet.Mvc
@{
    ViewData["Title"] = "Caja";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<p></p>
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">Caja</div>
    <div class="panel-body panel-body-personalizado">

        <div id="mensajes"></div>

        <p></p>

        <div class="input-group">
            <input type="text" name="dui_buscar" id="dui_buscar" placeholder="introduzca un DUI válido" class="form-control" />
            <span class="input-group-btn">
                <button class="btn btn-default" type="button" id="buscarpordui">Buscar</button>
            </span>
        </div>
        <p></p>
        <div class="panel panel-default">
            <div class="panel-body">
                <table>
                    <tr>
                        <th>Nombre completo: </th>
                        <td><span class="nombre_completo"></span></td>
                    </tr>
                    <tr>
                        <th>DUI: </th>
                        <td><span class="dui"></span></td>
                    </tr>
                </table>
            </div>
        </div>
        <p></p>
        <div style="min-height:400px">
            <ul id="cuentas" class="nav nav-tabs" role="tablist">
                <li class="active">
                    <a href="#ahorro" id="ahorro-tab" role="tab" data-toggle="tab" aria-controls="ahorro" aria-expanded="true">Cuentas de Ahorro</a>
                </li>
                <li>
                    <a href="#credito" id="credito-tab" role="tab" data-toggle="tab" aria-controls="credito" aria-expanded="true">Cuentas de Créditos</a>
                </li>
                <li>
                    <a href="#acciones" id="acciones-tab" role="tab" data-toggle="tab" aria-controls="acciones" aria-expanded="true">
                        <span id="contando_acciones"></span> Acciones pendientes
                    </a>
                </li>
                <li>
                    <a href="#deducciones" id="deducciones-tab" role="tab" data-toggle="tab" aria-controls="deducciones" aria-expanded="true">
                        <span id="contando_deducciones"></span> Deducciones
                    </a>
                </li>
                <li>
                    <a href="#otras_operaciones" id="otras_operaciones-tab" role="tab" data-toggle="tab" aria-controls="otras_operaciones" aria-expanded="true">
                        Otras operaciones
                    </a>
                </li>
            </ul>
            <div id="cuentasContenido" class="tab-content">
                <div role="tabpanel" class="tab-pane fade in active" id="ahorro" aria-labelledby="ahorro-tab">
                    @*Seleccionar cuenta de ahorro:
                        <div class="ahorros"></div>*@
                    <p></p>
                    <div class="well">

                        <div class="btn-group btn-group-lg" role="group" aria-label="...">
                            <div class="btn-group ahorros" role="group">
                            </div>
                            <div class="btn-group " role="group">
                                <input type="number" id="valor" class="form-control limpiar" />
                            </div>
                            <div class="btn-group" role="group">
                                <a href="#Modal_Para_Ahorros" data-toggle="modal" class="btn btn-default" id="deposito">Depósito</a>
                            </div>
                            <div class="btn-group" role="group">
                                <a href="#Modal_Para_Retiros" data-toggle="modal" id="retiro" class="btn btn-default">Retiro</a>
                            </div>
                            <div class="btn-group" role="group">
                                <span id="ncomprobante" style="display: none"></span>
                            </div>
                            <div class="btn-group" role="group">
                                <span id="ncomprobanteretiro" style="display: none"></span>
                            </div>
                        </div>
                        @Html.Partial("_Herramienta_Caja_Transaccion")
                    </div>
                    <p></p>
                    <div class="transacciones" style="overflow-y: scroll; height:300px;"></div>
                </div>
                <div role="tabpanel" class="tab-pane" id="credito" aria-labelledby="credito-tab">

                    <div class="well">
                        <div class="btn-group btn-group-lg" role="group" aria-label="...">
                            <div class="creditos btn-group" role="group">

                            </div>
                            <div class="btn-group" role="group">
                                <button class="btn btn-default abono" type="button">Registrar Abono</button>
                            </div>
                        </div>
                        @Html.Partial("_Herramienta_Caja_Transaccion")
                    </div>

                    <p></p>

                    <!-- Modal -->
                    <div class="modal fade" id="Modal_Para_Comprobante" style="align-content: center">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                    <h4 class="modal-title" id="myModalLabel">Ingrese el No. de Comprobante</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>Ingrese el número de comprobante para realizar un pago</label>
                                            <br />
                                            <label class="control-label">No Comprobante</label>
                                            <input class="form-control" id="numero_comprobante" type="number" />

                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                                    <button type="button" id="siguiente_comprobante" class="btn btn-primary">Continuar</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <p></p>
                    <div class="transaccionesCredito" style="overflow-y: scroll; height:300px;"></div>
                    <p>
                        <table>
                            <tr>
                                <td style="background-color:palegreen;padding:4px"> Puntual </td>
                                <td style="background-color:lemonchiffon;padding:4px"> Anticipado </td>
                                <td style="background-color:red;padding:4px"> Vencido </td>
                            </tr>
                        </table>
                    </p>
                </div>

                <div role="tabpanel" class="tab-pane" id="acciones" aria-labelledby="acciones-tab">
                    <div id="acciones_lista"></div>

                    <div class="modal fade" id="modal_detalle_cobro">
                        <div class="modal-dialog" style="width:800px">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <a href="#" class="close" data-dismiss="modal">
                                        <span aria-hidden="true">&times;</span>
                                        <span class="sr-only">Close</span>
                                    </a>
                                    <h4 class="modal-title">Registrar cobro</h4>
                                </div>

                                <div class="modal-body">
                                    No Acción: <b class="codigo_seleccionado"></b>

                                    <div class="form-group">
                                        <input type="button" id="registrar_cobro" value="Registrar cobro" class="form-control" />
                                    </div>

                                </div> <!-- /.modal-body -->

                            </div>
                        </div>
                    </div>

                </div>

                <div role="tabpanel" class="tab-pane" id="deducciones" aria-labelledby="deducciones-tab">
                    <div id="deducciones_lista"></div>

                    <div class="modal fade" id="modal_detalle_deduccion">
                        <div class="modal-dialog" style="width:800px">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <a href="#" class="close" data-dismiss="modal">
                                        <span aria-hidden="true">&times;</span>
                                        <span class="sr-only">Close</span>
                                    </a>
                                    <h4 class="modal-title">Registrar Deducción</h4>
                                </div>

                                <div class="modal-body">


                                    <div class="form-group">
                                        <input type="button" id="registrar_deduccion" value="Registrar deducción" class="form-control" />
                                    </div>

                                </div> <!-- /.modal-body -->

                            </div>
                        </div>
                    </div>

                </div>
                <div role="tabpanel" class="tab-pane" id="otras_operaciones" aria-labelledby="otras_operaciones-tab">
                    <p></p>
                    <div class="well">
                        <div class="btn-group btn-group-lg" role="group" aria-label="...">
                            <div class="btn-group" role="group">

                            </div>
                            <div class="btn-group" role="group">

                            </div>
                        </div>
                        @Html.Partial("_Herramienta_Caja_Transaccion")

                        <p></p>
                    </div>
                    <p></p>
                    <div id="lista_otras_operaciones"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ahorros-->
<div class="modal fade" id="Modal_Para_Ahorros" style="align-content: center">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Ingrese el No. de Comprobante</h4>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Ingrese el número de comprobante para realizar un Depósito</label>
                        <br />
                        <label class="control-label">No Comprobante</label>
                        <input class="form-control cdeposito" id="numero_comprobante_ahorro" type="number" />

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                <button type="button" id="siguiente_comprobante_ahorro" class="btn btn-primary">Continuar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ahorros-->
<div class="modal fade" id="Modal_Para_Retiros" style="align-content: center">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Ingrese el No. de Comprobante</h4>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Ingrese el número de comprobante para realizar un Retiro</label>
                        <br />
                        <label class="control-label">No Comprobante</label>
                        <input class="form-control cretiro" id="numero_comprobante_retiro" type="number" />

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                <button type="button" id="siguiente_comprobante_retiro" class="btn btn-primary">Continuar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Libreta-->
<div class="modal fade" id="Modal_Libreta" style="align-content: center">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Ingrese los siguientes datos para continuar</h4>
            </div>
            <div class="row">

            </div>
            <div class="modal-body">
                <div class="col-md-8">
                    <div class="form-group">
                        <label>Ingrese el número de renglón</label>
                        <br />
                        <input class="form-control cretiro" id="numero_renglon" type="number" />
                        <br />
                    </div>
                </div>
               
            </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                    <button type="button" id="siguiente_libreta" class="btn btn-primary">Continuar</button>
                </div>
            </div>
        </div>
</div>
<script>

    //buscando el una persona valida
    $(function () {
        $("#dui_buscar").mask("00000000-0");
        BuscarPorDui();
    });

    function BuscarPorDui() {
        $("#buscarpordui").click(function () {
            var filtro = $("#dui_buscar").val();
            $.get("@Url.Action("JDetalle_Persona","Persona")",
                { filtro: filtro },
                function (detalle) {
                    $("span.nombre_completo").text(detalle.nombreCompleto);
                    $("span.dui").text(detalle.dui);
                    ObtenerPersona(detalle.id_Persona);
                }).fail(function (error) {
                    alertify.error("No se encontró esa03552832 identificación");
                });
        });
    }



    function Mensaje(respuesta) {
        $("#mensajes").html("");
        $("#mensajes").html(respuesta);
    }

