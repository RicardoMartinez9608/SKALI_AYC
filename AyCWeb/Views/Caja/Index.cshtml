    function ObtenerData(e) {
        var id_credito = $("#Id_Credito").val();
        var fecha = $("#FechaPago").val();
        var valor_cuota = $("#Valor_Cuota").val();
        $.get("@Url.Action("ConsultaParaPago", "Credito")",
