    function OperacionGeneral(action,id_ahorro,valor,comprobante) {
        $.post(action,
            { id_ahorro: id_ahorro, valor: valor ,comprobante:comprobante},
            function (mensaje) {
                Mensaje(mensaje);
                CargarGridTransacciones(id_ahorro);
            }
        );
    }
    /*manejo de postear, revertir y condonar*/
    function SeleccionarTodosAhorro() {
        $("input[name='todas_transacciones_ahorro']").click(function () {
            $("input[name='transaccion_ahorro']").not(this).prop('checked', this.checked);
        });
    }
    function SeleccionarTodosCredito() {
        $("input[name='todas_transacciones_credito']").click(function () {
            $("input[name='transaccion_credito']").not(this).prop('checked', this.checked);
        });
    }
  
    function DatosLinea() {
        var ids_transaccion = [];
        var valores = "";
        var valor1 = "";
        var valor2 = "";
        var valor3 = "";
        var valor4 = "";
        var valor5 = "";
        $.each($("input[name='transaccion_ahorro']:checked"), function (index_ahorro) {
            ids_transaccion.push($(this).val());
            $(this).parents("tr").find("td").each(function() {
                valores += $(this).html();
                valor1 = $(this).parents("tr").find("td").eq(0).text();
                valor2 = $(this).parents("tr").find("td").eq(1).text();
                valor3 = $(this).parents("tr").find("td").eq(2).text();
                valor4 = $(this).parents("tr").find("td").eq(3).text();
                valor5 = $(this).parents("tr").find("td").eq(4).text();
            });
        });
        console.log(valor1,valor2, valor3,valor4,valor5);
        //     console.log(ids_transaccion);
    }

    function Agregar_Check_Ahorro() {
        var ids_transaccion_ahorro = [];
        $.each($("input[name='transaccion_ahorro']:checked"), function (index_ahorro) {
            ids_transaccion_ahorro.push($(this).val());
        });
        return ids_transaccion_ahorro;
    }

    function Agregar_Check_Credito() {
        var ids_transaccion_credito = [];
        $.each($("input[name='transaccion_credito']:checked"), function (index_credito) {
            ids_transaccion_credito.push($(this).val());
        });
        return ids_transaccion_credito;
    }



    function Enviar_Transaccion_Documento(id_transaccion, es_credito) {
        var a = document.createElement('a');
        if (es_credito) {
            a.href = '@Url.Action("Mostrar_Factura_Abono", "Credito")?id_transaccion=' + id_transaccion;
        }
        else {
            a.href = '@Url.Action("Mostrar_Recibo", "Ahorro")?id_transaccion=' + id_transaccion;
        }
        a.target = '_blank';
        document.body.appendChild(a);
        a.click();
    }

    //para mostrar factura de transacciones simples
    function Enviar_Transaccion_Simple_Documento(id_transaccion_simple) {
        var a = document.createElement('a');
        a.href = '@Url.Action("Mostrar_Comprobante_Factura", "Caja")?id_transaccion_simple=' + id_transaccion_simple;
        a.target = '_blank';
        document.body.appendChild(a);
        a.click();
    }

    function Mostrar_Factura_Transaccion() {
        $("a.postear").click(function () {
            /*ids_ahorro para sus transacciones */
            var id_ahorro = $("input[name='transaccion_ahorro']:checked").eq(0).val();
            /*ids_creditos para transacciones*/
            var id_credito = $("input[name='transaccion_credito']:checked").eq(0).val();
            /*ids_comunes para transacciones*/
            var id_transaccion_simple = $("input[name='transaccion_comun']:checked").eq(0).val();

            console.log(id_transaccion_simple);

            if (id_ahorro != null) {
                Enviar_Transaccion_Documento(id_ahorro, false);
            }

            if (id_credito != null) {
                Enviar_Transaccion_Documento(id_credito, true);
            }

            if (id_transaccion_simple != null) {
                Enviar_Transaccion_Simple_Documento(id_transaccion_simple);
            }
        });
    }

    /*para cobrar acciones pendientes*/
    function Acciones_Pendientes(id_persona) {
        $.get("@Url.Action("Acciones_Cancelar", "Accion")",
            {
                id_persona: id_persona
            },
            function (lista_acciones) {
                $("#acciones_lista").html(lista_acciones);

                var cuenta = $("tr.accion_fila").size();
                if (cuenta > 0)
                    $("#contando_acciones").html("<span class='badge'>" + cuenta + "</span>");

                Cobro_Accion_Registrado();
        });
    }

    function Cobro_Accion_Registrado() {
        $("a.registrar_cobro_accion").each(function (index) {
            $("a.registrar_cobro_accion").eq(index).click(function () {
                var codigo = $("input.codigo").eq(index).val();
                var id_accion = $("input.id_accion").eq(index).val();
                ///llenar los datos del pop
                $("b.codigo_seleccionado").html(codigo);
                EjecutarCobro(id_accion);
            });
        });
    }

    function EjecutarCobro(id_accion) {
        $("#registrar_cobro").click(function () {
            $.post("@Url.Action("Registrar_Cobro", "Accion")",
            {id_accion:id_accion},
            function (resultado) {
                alertify.success(resultado);
                var id_persona = $("#id_persona_valor").val();
                Lista_Otras_Operaciones(id_persona);
            }).fail(function (badrequest) {
                alertify.error("El cobro no se pudo efectuar");
            });
        });
    }

    //para cobrar deducciones al desembolsar
    function Deducciones_Historial(id_persona) {
        $.get("@Url.Action("Deducciones_Historial", "Credito")",
            {
                id_persona: id_persona
            },
            function (lista_deducciones) {
                $("#deducciones_lista").html(lista_deducciones);

                var cuenta = $("tr.deduccion_fila").size();
                if (cuenta > 0)
                    $("#contando_deducciones").html("<span class='badge'>" + cuenta + "</span>");
                Cobro_Deduccion_Registrado();
        });
    }

    function Cobro_Deduccion_Registrado() {
        $("a.Cobrar_Deduccion").each(function (index) {
            $("a.Cobrar_Deduccion").eq(index).click(function () {
                var id_deduccion = $("input.id_deduccion_historial_valor").eq(index).val();
                ///llenar los datos del pop
                EjecutarCobroDeduccion(id_deduccion);
            });
        });
    }

    function EjecutarCobroDeduccion(id_deduccion) {
        $("#registrar_deduccion").click(function () {
            $.post("@Url.Action("Cobro_Deduccion", "Credito")",
                { id_deduccion: id_deduccion},
            function (resultado) {
                alertify.success(resultado);
                var id_persona = $("#id_persona_valor").val();
                Deducciones_Historial(id_persona);//volver a cargar las deducciones si aun quedan
                Lista_Otras_Operaciones(id_persona);
            }).fail(function (badrequest) {
                alertify.error(badrequest.responseText);
            });
        });
    }

    //trabajo de otras operaciones
    function Lista_Otras_Operaciones(id_persona) {
        $.get(
            "@Url.Action("Transacciones_Comunes","Caja")",
            {
                id_persona: id_persona
            },
            function (operaciones) {
                $("#lista_otras_operaciones").html(operaciones);
                Mostrar_Factura_Transaccion();
        });
    }

</script>
