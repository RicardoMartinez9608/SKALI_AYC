@model ModelNucleo.Model.Contabilidad.Conf_Partida_Contable

<h4>Editar Partida Contable</h4>
<hr />
<div class="editar_configuracion">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Id_Conf_Partida_Contable" type="hidden" class="form-control" />
    <div class="form-group">
        <label asp-for="Identificador" class="control-label">Identificador</label>
        <input asp-for="Identificador" class="form-control" />
        <span asp-validation-for="Identificador" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Descripcion" class="control-label">Descripción</label>
        <input asp-for="Descripcion" class="form-control" />
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Id_Agencia" class="control-label">Agencia</label>
        @Html.DropDownList("Id_Agencia", null, htmlAttributes: new { @class = "form-control" })
        <span asp-validation-for="Id_Agencia" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Id_Linea_Credito" class="control-label">Línea de crédito</label>
        @Html.DropDownList("Id_Linea_Credito", null, htmlAttributes: new { @class = "form-control" })
        <span asp-validation-for="Id_Linea_Credito" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Id_Linea_Ahorro" class="control-label">Línea de ahorro</label>
        @Html.DropDownList("Id_Linea_Ahorro", null, htmlAttributes: new { @class = "form-control" })
        <span asp-validation-for="Id_Linea_Ahorro" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Guardar" id="Guardar_Editar_Configuracion" class="btn btn-default" />
    </div>
</div>


