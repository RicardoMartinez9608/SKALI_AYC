@model ModelNucleo.Model.Contabilidad.Conf_Detalle_Partida_Contable

    <div class="conf_detalle_partida">
        <input asp-for="Id_Conf_Partida_Contable" value="@ViewBag.Id_Conf_Partida_Contable" type="hidden" class="form-control" />
        <div class="form-group">
            <label asp-for="Cuenta_Contable" class="control-label"></label>
            <input asp-for="Cuenta_Contable" class="form-control" />
            <span asp-validation-for="Cuenta_Contable" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Identificador" class="control-label"></label>
            <input asp-for="Identificador" class="form-control" />
            <span asp-validation-for="Identificador" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Concepto" class="control-label"></label>
            <input asp-for="Concepto" class="form-control" />
            <span asp-validation-for="Concepto" class="text-danger"></span>
        </div>
        <div class="form-group">
            <div class="checkbox">
                <label>
                    <input asp-for="Cargo" /> @Html.DisplayNameFor(model => model.Cargo)
                </label>
            </div>
        </div>
        <div class="form-group">
            <div class="checkbox">
                <label>
                    <input asp-for="Abono" /> @Html.DisplayNameFor(model => model.Abono)
                </label>
            </div>
        </div>
        <div class="form-group">
            <input type="button" value="Guardar" class="btn btn-default" id="Guardar_Nueva_Conf_Detalle"/>
        </div>
    </div>
