@using DevExtreme.AspNet.Mvc
<div class="panel panel-default">
    <div class="panel-heading panel-heading-personalizado">
        <h4>Seleccione la Fotografía a Subir</h4>
    </div>
    <div class="panel-body panel-body-personalizado">
        <div class="row">
            <div class="col-md-12">
                
                    @{
                        var linea = "";
                    }
                    @(
                        Html.DevExtreme().FileUploader()
                        .ID("File_Uploader")
                        .Name("Documento")
                        .Multiple(false)
                        .Accept("*")
                        .UploadMode(FileUploadMode.Instantly)
                        .UploadButtonText("Subir archivo")
                        .SelectButtonText("Subir archivo")
                        .LabelText("Soltar archivo")

                    .UploadUrl(Url.Action("Subir_Foto_Colecta", "Colecta",
                        new
                        {
                            id_colecta = ViewBag.id_colecta,
                            id_cliente = ViewBag.id_cliente,
                            nombre = ViewBag.nombre
                        }))
                        )



              
            </div>
           
        </div>
    </div>
</div>
